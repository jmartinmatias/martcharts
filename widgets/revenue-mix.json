{
  "id": "revenue-mix",
  "title": "Revenue mix",
  "subtitle": "Q3 2026, Core and Plus by region",
  "description": "How each region's revenue splits between the two products, largest region first.",
  "source": {
    "name": "Sales ledger"
  },
  "locale": "en-US",
  "data": {
    "type": "url",
    "url": "/data/sales.json",
    "path": "data.items"
  },
  "transform": [
    {
      "type": "pivot",
      "row": "region",
      "column": "product",
      "value": "revenue"
    },
    {
      "type": "calc",
      "as": "total",
      "op": "add",
      "left": "Core",
      "right": "Plus"
    },
    {
      "type": "sort",
      "field": "total",
      "order": "desc"
    }
  ],
  "fields": {
    "Core": {
      "format": {
        "type": "currency",
        "currency": "EUR",
        "compact": true
      }
    },
    "Plus": {
      "format": {
        "type": "currency",
        "currency": "EUR",
        "compact": true
      }
    },
    "total": {
      "label": "Total",
      "format": {
        "type": "currency",
        "currency": "EUR",
        "compact": true
      }
    },
    "region": {}
  },
  "headline": {
    "value": "total",
    "agg": "sum",
    "caption": "Q3 revenue across both products"
  },
  "view": {
    "type": "bar",
    "x": "region",
    "y": [
      "Core",
      "Plus"
    ],
    "stacked": true
  },
  "i18n": {
    "fr": {
      "title": "Mix de revenus",
      "subtitle": "T3 2026, Core et Plus par région",
      "description": "La répartition du CA de chaque région entre les deux produits, plus grande région d'abord.",
      "source": {
        "name": "Journal des ventes"
      },
      "headline": {
        "caption": "CA du T3, les deux produits"
      },
      "fields": {
        "region": {
          "values": {
            "East": "Est",
            "North": "Nord",
            "Central": "Centre",
            "West": "Ouest",
            "South": "Sud"
          }
        }
      }
    },
    "de": {
      "title": "Umsatzmix",
      "subtitle": "Q3 2026, Core und Plus nach Region",
      "description": "Wie sich der Umsatz jeder Region auf die zwei Produkte verteilt, größte Region zuerst.",
      "source": {
        "name": "Verkaufsjournal"
      },
      "fields": {
        "total": {
          "label": "Gesamt"
        },
        "region": {
          "values": {
            "East": "Ost",
            "North": "Nord",
            "Central": "Mitte",
            "West": "West",
            "South": "Süd"
          }
        }
      },
      "headline": {
        "caption": "Umsatz Q3, beide Produkte"
      }
    }
  }
}
