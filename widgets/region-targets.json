{
  "id": "region-targets",
  "title": "Target attainment",
  "subtitle": "September 2026 revenue against plan",
  "description": "How close each region is to its September revenue target.",
  "source": {
    "name": "Sales ledger"
  },
  "locale": "en-US",
  "data": {
    "type": "url",
    "url": "/data/sales.json",
    "path": "data.items"
  },
  "transform": [
    {
      "type": "aggregate",
      "groupBy": "region",
      "measures": [
        {
          "op": "sum",
          "field": "revenue"
        },
        {
          "op": "sum",
          "field": "target"
        }
      ]
    },
    {
      "type": "sort",
      "field": "revenue",
      "order": "desc"
    }
  ],
  "fields": {
    "revenue": {
      "format": {
        "type": "currency",
        "currency": "EUR",
        "compact": true
      }
    },
    "target": {
      "format": {
        "type": "currency",
        "currency": "EUR",
        "compact": true
      }
    },
    "region": {}
  },
  "view": {
    "type": "meter",
    "value": "revenue",
    "target": "target",
    "label": "region"
  },
  "i18n": {
    "fr": {
      "title": "Atteinte des objectifs",
      "subtitle": "CA de septembre 2026 face au plan",
      "description": "À quelle distance chaque région est de son objectif de septembre.",
      "source": {
        "name": "Journal des ventes"
      },
      "fields": {
        "region": {
          "values": {
            "East": "Est",
            "North": "Nord",
            "Central": "Centre",
            "West": "Ouest",
            "South": "Sud"
          }
        }
      }
    },
    "de": {
      "title": "Zielerreichung",
      "subtitle": "Umsatz September 2026 gegen Plan",
      "description": "Wie nah jede Region an ihrem Septemberziel ist.",
      "source": {
        "name": "Verkaufsjournal"
      },
      "fields": {
        "region": {
          "values": {
            "East": "Ost",
            "North": "Nord",
            "Central": "Mitte",
            "West": "West",
            "South": "Süd"
          }
        }
      }
    }
  }
}
