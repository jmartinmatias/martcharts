{
  "id": "revenue-by-region",
  "title": "Revenue by region",
  "subtitle": "September 2026, all products",
  "description": "Revenue and cost per sales region, largest first, with the leading region highlighted.",
  "note": "September 2026, booked revenue and cost",
  "source": {
    "name": "Finance ledger",
    "url": "https://example.com/finance/ledger"
  },
  "locale": "en-US",
  "data": {
    "type": "url",
    "url": "/data/sales.json",
    "path": "data.items"
  },
  "transform": [
    {
      "type": "aggregate",
      "groupBy": "region",
      "measures": [
        {
          "op": "sum",
          "field": "revenue"
        },
        {
          "op": "sum",
          "field": "cost"
        }
      ]
    },
    {
      "type": "sort",
      "field": "revenue",
      "order": "desc"
    }
  ],
  "fields": {
    "revenue": {
      "label": "Revenue",
      "format": {
        "type": "currency",
        "currency": "EUR",
        "decimals": 0
      }
    },
    "cost": {
      "label": "Cost",
      "format": {
        "type": "currency",
        "currency": "EUR",
        "decimals": 0
      }
    }
  },
  "headline": {
    "value": "revenue",
    "agg": "sum",
    "caption": "total revenue"
  },
  "view": {
    "type": "bar",
    "x": "region",
    "y": [
      "revenue",
      "cost"
    ],
    "highlight": "East"
  }
}
