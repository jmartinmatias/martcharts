{
  "id": "revenue-by-region",
  "title": "Revenue by region",
  "subtitle": "September 2026, all products",
  "description": "Revenue and cost per sales region, largest first, with the leading region highlighted.",
  "note": "September 2026, booked revenue and cost",
  "source": {
    "name": "Finance ledger",
    "url": "https://example.com/finance/ledger"
  },
  "locale": "en-US",
  "data": {
    "type": "url",
    "url": "/data/sales.json",
    "path": "data.items"
  },
  "transform": [
    {
      "type": "aggregate",
      "groupBy": "region",
      "measures": [
        {
          "op": "sum",
          "field": "revenue"
        },
        {
          "op": "sum",
          "field": "cost"
        }
      ]
    },
    {
      "type": "sort",
      "field": "revenue",
      "order": "desc"
    }
  ],
  "fields": {
    "revenue": {
      "label": "Revenue",
      "format": {
        "type": "currency",
        "currency": "EUR",
        "decimals": 0
      }
    },
    "cost": {
      "label": "Cost",
      "format": {
        "type": "currency",
        "currency": "EUR",
        "decimals": 0
      }
    }
  },
  "headline": {
    "value": "revenue",
    "agg": "sum",
    "caption": "total revenue"
  },
  "view": {
    "type": "bar",
    "x": "region",
    "y": [
      "revenue",
      "cost"
    ],
    "highlight": "East",
    "reference": [
      {
        "field": "revenue",
        "agg": "avg",
        "label": "Average"
      }
    ]
  },
  "i18n": {
    "fr": {
      "title": "CA par région",
      "subtitle": "Septembre 2026, tous produits",
      "description": "CA et coûts par région commerciale, plus grande d'abord, la région en tête mise en avant.",
      "note": "Septembre 2026, CA et coûts comptabilisés",
      "source": {
        "name": "Grand livre"
      },
      "fields": {
        "revenue": {
          "label": "Chiffre d'affaires"
        },
        "cost": {
          "label": "Coût"
        }
      },
      "headline": {
        "caption": "chiffre d'affaires total"
      },
      "view": {
        "reference": [
          {
            "label": "Moyenne"
          }
        ]
      }
    },
    "de": {
      "title": "Umsatz je Region",
      "subtitle": "September 2026, alle Produkte",
      "description": "Umsatz und Kosten je Vertriebsregion, größte zuerst, die führende hervorgehoben.",
      "note": "September 2026, gebuchter Umsatz und Kosten",
      "source": {
        "name": "Hauptbuch"
      },
      "fields": {
        "revenue": {
          "label": "Umsatz"
        },
        "cost": {
          "label": "Kosten"
        }
      },
      "headline": {
        "caption": "Gesamtumsatz"
      },
      "view": {
        "reference": [
          {
            "label": "Durchschnitt"
          }
        ]
      }
    }
  }
}
