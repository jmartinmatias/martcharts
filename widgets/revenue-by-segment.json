{
  "id": "revenue-by-segment",
  "title": "Revenue by segment",
  "subtitle": "Year to date",
  "description": "How revenue splits across customer segments.",
  "source": {"name": "CRM"},
  "locale": "en-US",
  "data": {
    "type": "url",
    "url": "/data/customers.json"
  },
  "transform": [
    {
      "type": "aggregate",
      "groupBy": "segment",
      "measures": [
        {
          "op": "sum",
          "field": "revenue"
        }
      ]
    },
    {
      "type": "sort",
      "field": "revenue",
      "order": "desc"
    }
  ],
  "fields": {
    "revenue": {
      "label": "Revenue",
      "format": {
        "type": "currency",
        "currency": "EUR",
        "compact": true
      }
    }
  },
  "view": {
    "type": "donut",
    "label": "segment",
    "value": "revenue"
  },
  "i18n": {
    "fr": {
      "title": "CA par segment",
      "subtitle": "Depuis janvier",
      "description": "La répartition du CA par segment de clientèle.",
      "fields": {
        "revenue": {
          "label": "Chiffre d'affaires"
        }
      }
    },
    "de": {
      "title": "Umsatz je Segment",
      "subtitle": "Seit Jahresbeginn",
      "description": "Wie sich der Umsatz auf Kundensegmente verteilt.",
      "fields": {
        "revenue": {
          "label": "Umsatz"
        }
      }
    }
  }
}
