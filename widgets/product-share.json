{
  "id": "product-share",
  "title": "Product share",
  "subtitle": "Of each region's revenue",
  "description": "Core and Plus as a share of each region's revenue.",
  "source": {
    "name": "Sales ledger"
  },
  "locale": "en-US",
  "data": {
    "type": "url",
    "url": "/data/sales.json",
    "path": "data.items"
  },
  "transform": [
    {
      "type": "pivot",
      "row": "region",
      "column": "product",
      "value": "revenue"
    },
    {
      "type": "calc",
      "as": "total",
      "op": "add",
      "left": "Core",
      "right": "Plus"
    },
    {
      "type": "sort",
      "field": "total",
      "order": "desc"
    }
  ],
  "fields": {
    "Core": {
      "format": {
        "type": "currency",
        "currency": "EUR",
        "compact": true
      }
    },
    "Plus": {
      "format": {
        "type": "currency",
        "currency": "EUR",
        "compact": true
      }
    },
    "region": {}
  },
  "view": {
    "type": "bar",
    "x": "region",
    "y": [
      "Core",
      "Plus"
    ],
    "stacked": "percent"
  },
  "i18n": {
    "fr": {
      "title": "Part des produits",
      "subtitle": "Du CA de chaque région",
      "description": "Core et Plus en part du CA de chaque région.",
      "source": {
        "name": "Journal des ventes"
      },
      "fields": {
        "region": {
          "values": {
            "East": "Est",
            "North": "Nord",
            "Central": "Centre",
            "West": "Ouest",
            "South": "Sud"
          }
        }
      }
    },
    "de": {
      "title": "Produktanteil",
      "subtitle": "Am Umsatz jeder Region",
      "description": "Core und Plus als Anteil am Umsatz jeder Region.",
      "source": {
        "name": "Verkaufsjournal"
      },
      "fields": {
        "region": {
          "values": {
            "East": "Ost",
            "North": "Nord",
            "Central": "Mitte",
            "West": "West",
            "South": "Süd"
          }
        }
      }
    }
  }
}
