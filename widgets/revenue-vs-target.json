{
  "id": "revenue-vs-target",
  "title": "Revenue against target",
  "subtitle": "{first:month} to {last:month}",
  "description": "Monthly revenue as bars with the monthly target as a line, on one axis.",
  "source": {"name": "Finance ledger"},
  "locale": "en-US",
  "data": {
    "type": "url",
    "url": "/data/monthly-by-region.json"
  },
  "transform": [
    {
      "type": "aggregate",
      "groupBy": "month",
      "measures": [
        { "op": "sum", "field": "revenue", "as": "revenue" },
        { "op": "sum", "field": "target", "as": "target" }
      ]
    }
  ],
  "fields": {
    "month": {
      "label": "Month",
      "format": {
        "type": "date",
        "style": "month"
      }
    },
    "revenue": {
      "label": "Revenue",
      "format": {
        "type": "currency",
        "currency": "EUR",
        "compact": true
      }
    },
    "target": {
      "label": "Target",
      "format": {
        "type": "currency",
        "currency": "EUR",
        "compact": true
      }
    }
  },
  "view": {
    "type": "bar",
    "x": "month",
    "y": "revenue",
    "lines": "target"
  },
  "i18n": {
    "fr": {
      "title": "CA face à l'objectif",
      "subtitle": "{first:month} à {last:month}",
      "description": "CA mensuel en barres et objectif mensuel en ligne, sur un même axe.",
      "source": {
        "name": "Grand livre"
      },
      "fields": {
        "month": {
          "label": "Mois"
        },
        "revenue": {
          "label": "Chiffre d'affaires"
        },
        "target": {
          "label": "Objectif"
        }
      }
    },
    "de": {
      "title": "Umsatz gegen Ziel",
      "subtitle": "{first:month} bis {last:month}",
      "description": "Monatsumsatz als Balken, Monatsziel als Linie, auf einer Achse.",
      "source": {
        "name": "Hauptbuch"
      },
      "fields": {
        "month": {
          "label": "Monat"
        },
        "revenue": {
          "label": "Umsatz"
        },
        "target": {
          "label": "Ziel"
        }
      }
    }
  }
}
