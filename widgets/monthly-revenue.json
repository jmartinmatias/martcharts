{
  "id": "monthly-revenue",
  "title": "Revenue and cost",
  "subtitle": "{first:month} to {last:month}",
  "description": "Monthly revenue and cost trend from the finance ledger.",
  "source": {"name": "Finance ledger"},
  "locale": "en-US",
  "data": {
    "type": "url",
    "url": "/data/monthly-by-region.json"
  },
  "transform": [
    {
      "type": "aggregate",
      "groupBy": "month",
      "measures": [
        { "op": "sum", "field": "revenue", "as": "revenue" },
        { "op": "sum", "field": "cost", "as": "cost" },
        { "op": "sum", "field": "target", "as": "target" }
      ]
    }
  ],
  "fields": {
    "month": {
      "label": "Month",
      "format": {
        "type": "date",
        "style": "month"
      }
    },
    "revenue": {
      "label": "Revenue",
      "format": {
        "type": "currency",
        "currency": "EUR",
        "decimals": 0
      }
    },
    "cost": {
      "label": "Cost",
      "format": {
        "type": "currency",
        "currency": "EUR",
        "decimals": 0
      }
    }
  },
  "headline": {
    "value": "revenue",
    "compare": "previous",
    "compareLabel": "vs Aug",
    "caption": "revenue in {last:month}"
  },
  "view": {
    "type": "line",
    "x": "month",
    "y": [
      "revenue",
      "cost"
    ],
    "reference": [
      {
        "field": "target",
        "agg": "last",
        "label": "Target"
      }
    ]
  }
}
