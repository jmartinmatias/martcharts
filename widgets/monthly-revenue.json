{
  "id": "monthly-revenue",
  "title": "Revenue and cost",
  "subtitle": "{first:month} to {last:month}",
  "description": "Monthly revenue and cost trend from the finance ledger.",
  "source": {"name": "Finance ledger"},
  "locale": "en-US",
  "data": {
    "type": "url",
    "url": "/data/monthly-by-region.json"
  },
  "transform": [
    {
      "type": "aggregate",
      "groupBy": "month",
      "measures": [
        { "op": "sum", "field": "revenue", "as": "revenue" },
        { "op": "sum", "field": "cost", "as": "cost" },
        { "op": "sum", "field": "target", "as": "target" }
      ]
    }
  ],
  "fields": {
    "month": {
      "label": "Month",
      "format": {
        "type": "date",
        "style": "month"
      }
    },
    "revenue": {
      "label": "Revenue",
      "format": {
        "type": "currency",
        "currency": "EUR",
        "decimals": 0
      }
    },
    "cost": {
      "label": "Cost",
      "format": {
        "type": "currency",
        "currency": "EUR",
        "decimals": 0
      }
    }
  },
  "headline": {
    "value": "revenue",
    "compare": "previous",
    "compareLabel": "vs Aug",
    "caption": "revenue in {last:month}"
  },
  "view": {
    "type": "line",
    "x": "month",
    "y": [
      "revenue",
      "cost"
    ],
    "reference": [
      {
        "field": "target",
        "agg": "last",
        "label": "Target"
      }
    ]
  },
  "i18n": {
    "fr": {
      "title": "CA et coûts",
      "subtitle": "{first:month} à {last:month}",
      "description": "Tendance mensuelle du CA et des coûts, issue du grand livre.",
      "source": {
        "name": "Grand livre"
      },
      "fields": {
        "month": {
          "label": "Mois"
        },
        "revenue": {
          "label": "Chiffre d'affaires"
        },
        "cost": {
          "label": "Coût"
        }
      },
      "headline": {
        "compareLabel": "vs août",
        "caption": "CA de {last:month}"
      },
      "view": {
        "reference": [
          {
            "label": "Objectif"
          }
        ]
      }
    },
    "de": {
      "title": "Umsatz und Kosten",
      "subtitle": "{first:month} bis {last:month}",
      "description": "Monatlicher Umsatz- und Kostentrend aus dem Hauptbuch.",
      "source": {
        "name": "Hauptbuch"
      },
      "fields": {
        "month": {
          "label": "Monat"
        },
        "revenue": {
          "label": "Umsatz"
        },
        "cost": {
          "label": "Kosten"
        }
      },
      "headline": {
        "compareLabel": "ggü. Aug.",
        "caption": "Umsatz im {last:month}"
      },
      "view": {
        "reference": [
          {
            "label": "Ziel"
          }
        ]
      }
    }
  }
}
