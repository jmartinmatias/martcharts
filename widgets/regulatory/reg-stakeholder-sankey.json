{
  "id": "reg-stakeholder-sankey",
  "title": "Who must comply, by topic",
  "subtitle": "Flows from each topic to the stakeholder types its rules bind",
  "description": "How the body of rules lands on each kind of firm: the thicker the band, the more rules of that topic bind that type.",
  "locale": "en-US",
  "data": {
    "type": "url",
    "url": "/data/regulation-stakeholders.json"
  },
  "fields": {
    "topic": {
      "label": "Topic"
    },
    "stakeholder": {
      "label": "Stakeholder type"
    },
    "regulations": {
      "label": "Regulations"
    }
  },
  "view": {
    "type": "sankey",
    "source": "topic",
    "target": "stakeholder",
    "value": "regulations"
  },
  "source": {
    "name": "Regulatory watch (fictional)"
  },
  "byline": "Compliance office",
  "transform": [
    {
      "type": "filter",
      "field": "binds",
      "value": true
    },
    {
      "type": "aggregate",
      "groupBy": [
        "topic",
        "stakeholder"
      ],
      "measures": [
        {
          "op": "count",
          "as": "regulations"
        }
      ]
    }
  ]
}
