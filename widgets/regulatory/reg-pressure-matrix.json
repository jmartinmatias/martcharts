{
  "id": "reg-pressure-matrix",
  "title": "Pressure by topic and quarter",
  "subtitle": "Obligations landing, and their average impact",
  "description": "Where and when the obligations land: each circle is one topic in one quarter, sized by obligations and colored by impact.",
  "locale": "en-US",
  "data": {
    "type": "url",
    "url": "/data/regulatory-activity-split.json"
  },
  "fields": {
    "quarter": {
      "label": "Quarter",
      "format": {
        "type": "date",
        "style": "quarter"
      }
    },
    "topic": {
      "label": "Topic"
    },
    "obligations": {
      "label": "Obligations"
    },
    "impact": {
      "label": "Average impact",
      "format": {
        "type": "number",
        "decimals": 1
      }
    }
  },
  "view": {
    "type": "matrix",
    "x": "quarter",
    "y": "topic",
    "size": "obligations",
    "color": "impact"
  },
  "source": {
    "name": "Regulatory watch (fictional)"
  },
  "transform": [
    {
      "type": "aggregate",
      "groupBy": [
        "quarter",
        "topic"
      ],
      "measures": [
        {
          "op": "sum",
          "field": "obligations",
          "as": "obligations"
        },
        {
          "op": "sum",
          "field": "impactPoints",
          "as": "impactPoints"
        }
      ]
    },
    {
      "type": "calc",
      "as": "impact",
      "op": "divide",
      "left": "impactPoints",
      "right": "obligations"
    }
  ],
  "i18n": {
    "fr": {
      "title": "Pression par thème et trimestre",
      "subtitle": "Obligations qui tombent, et leur impact moyen",
      "description": "Où et quand les obligations tombent : chaque cercle est un thème sur un trimestre, taillé par les obligations et coloré par l'impact.",
      "fields": {
        "quarter": {
          "label": "Trimestre"
        },
        "topic": {
          "label": "Thème",
          "values": {
            "Operational resilience": "Résilience opérationnelle",
            "AML & sanctions": "LCB-FT et sanctions",
            "ESG & sustainability": "ESG et durabilité",
            "Prudential": "Prudentiel",
            "Consumer protection": "Protection des consommateurs",
            "Markets": "Marchés",
            "Payments": "Paiements",
            "Data, AI & digital": "Données, IA et numérique"
          }
        },
        "impact": {
          "label": "Impact moyen"
        }
      },
      "source": {
        "name": "Veille réglementaire (fictive)"
      }
    },
    "de": {
      "title": "Druck je Thema und Quartal",
      "subtitle": "Greifende Pflichten und ihre mittlere Wirkung",
      "description": "Wo und wann die Pflichten greifen: jeder Kreis ist ein Thema in einem Quartal, nach Pflichten bemessen und nach Wirkung gefärbt.",
      "fields": {
        "quarter": {
          "label": "Quartal"
        },
        "topic": {
          "label": "Thema",
          "values": {
            "Operational resilience": "Operative Resilienz",
            "AML & sanctions": "Geldwäsche und Sanktionen",
            "ESG & sustainability": "ESG und Nachhaltigkeit",
            "Prudential": "Aufsichtsrecht",
            "Consumer protection": "Verbraucherschutz",
            "Markets": "Märkte",
            "Payments": "Zahlungsverkehr",
            "Data, AI & digital": "Daten, KI und Digitales"
          }
        },
        "obligations": {
          "label": "Pflichten"
        },
        "impact": {
          "label": "Mittlere Wirkung"
        }
      },
      "source": {
        "name": "Regulierungsbeobachtung (fiktiv)"
      }
    }
  }
}
