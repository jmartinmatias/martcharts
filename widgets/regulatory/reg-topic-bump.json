{
  "id": "reg-topic-bump",
  "title": "Topics ranked by activity",
  "subtitle": "Events per quarter, 2024 to 2026",
  "description": "Which topics generated the most events each quarter, and who overtook whom; AI and sustainability are kept in color.",
  "locale": "en-US",
  "data": {
    "type": "url",
    "url": "/data/regulatory-activity-split.json"
  },
  "transform": [
    {
      "type": "filter",
      "field": "quarter",
      "op": "<=",
      "value": "2026-Q4"
    },
    {
      "type": "aggregate",
      "groupBy": [
        "quarter",
        "topic"
      ],
      "measures": [
        {
          "op": "sum",
          "field": "events",
          "as": "events"
        }
      ]
    }
  ],
  "fields": {
    "quarter": {
      "label": "Quarter"
    },
    "topic": {
      "label": "Topic"
    },
    "events": {
      "label": "Events"
    }
  },
  "view": {
    "type": "bump",
    "x": "quarter",
    "series": "topic",
    "value": "events",
    "highlight": [
      "Data, AI & digital",
      "ESG & sustainability"
    ]
  },
  "source": {
    "name": "Regulatory watch (fictional)"
  },
  "byline": "Compliance office"
}
