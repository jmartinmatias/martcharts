{
  "id": "reg-stage-funnel",
  "title": "From proposal to application",
  "subtitle": "How many of the 40 tracked rules have reached each stage by 25 October 2026, whatever their status today",
  "description": "The lifecycle as a funnel: every rule was proposed; fewer are adopted, in force, and applying today.",
  "locale": "en-US",
  "data": {
    "type": "url",
    "url": "/data/regulation-stages.json"
  },
  "fields": {
    "stage": {
      "label": "Stage"
    },
    "regulations": {
      "label": "Regulations"
    }
  },
  "view": {
    "type": "funnel",
    "label": "stage",
    "value": "regulations"
  },
  "source": {
    "name": "Regulatory watch (fictional)"
  },
  "byline": "Compliance office",
  "transform": [
    {
      "type": "aggregate",
      "groupBy": "stage",
      "measures": [
        {
          "op": "sum",
          "field": "regulations",
          "as": "regulations"
        }
      ]
    }
  ]
}
