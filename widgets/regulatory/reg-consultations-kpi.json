{
  "id": "reg-consultations-kpi",
  "title": "Open consultations",
  "subtitle": "{last:month}, with the trend since {first:month}",
  "description": "Consultations open at the end of the month, against the month before.",
  "locale": "en-US",
  "data": {
    "type": "url",
    "url": "/data/regulatory-pressure-split.json"
  },
  "transform": [
    {
      "type": "filter",
      "field": "forecast",
      "op": "==",
      "value": false
    },
    {
      "type": "aggregate",
      "groupBy": "month",
      "measures": [
        {
          "op": "sum",
          "field": "consultationsOpen",
          "as": "consultationsOpen"
        }
      ]
    },
    {
      "type": "sort",
      "field": "month"
    }
  ],
  "fields": {
    "month": {
      "label": "Month",
      "format": {
        "type": "date",
        "style": "month"
      }
    },
    "consultationsOpen": {
      "label": "Consultations"
    }
  },
  "view": {
    "type": "kpi",
    "value": "consultationsOpen",
    "series": true,
    "x": "month"
  },
  "source": {
    "name": "Regulatory watch (fictional)"
  },
  "i18n": {
    "fr": {
      "title": "Consultations ouvertes",
      "subtitle": "{last:month}, avec la tendance depuis {first:month}",
      "description": "Consultations ouvertes en fin de mois, face au mois précédent.",
      "fields": {
        "month": {
          "label": "Mois"
        }
      },
      "source": {
        "name": "Veille réglementaire (fictive)"
      }
    },
    "de": {
      "title": "Offene Konsultationen",
      "subtitle": "{last:month}, mit dem Trend seit {first:month}",
      "description": "Offene Konsultationen zum Monatsende gegen den Vormonat.",
      "fields": {
        "month": {
          "label": "Monat"
        },
        "consultationsOpen": {
          "label": "Konsultationen"
        }
      },
      "source": {
        "name": "Regulierungsbeobachtung (fiktiv)"
      }
    }
  }
}
