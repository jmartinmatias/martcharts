          "label": "Tage übrig"
        },
        "regulation": {
          "label": "Vorschrift"
        },
        "milestone": {
          "label": "Meilenstein"
        },
        "owner": {
          "label": "Verantwortlich"
        },
        "readiness": {
          "label": "Bereitschaft"
        },
        "readinessPct": {
          "label": "Bisher erledigt"
        },
        "topic": {
          "label": "Thema"
        }
      },
      "source": {
        "name": "Regulierungsbeobachtung (fiktiv)"
      }
    }
  }
}
