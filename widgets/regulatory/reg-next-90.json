{
  "id": "reg-next-90",
  "title": "Due in the next 90 days",
  "subtitle": "Every milestone, soonest first, with its owner and readiness",
  "description": "The compliance officer's list: each deadline in the next ninety days, its rule, the owning team, and whether the work is done, in progress or not started.",
  "locale": "en-US",
  "data": {
    "type": "url",
    "url": "/data/regulatory-deadlines.json"
  },
  "transform": [
    {
      "type": "filter",
      "field": "daysLeft",
      "op": ">=",
      "value": 0
    },
    {
      "type": "filter",
      "field": "daysLeft",
      "op": "<=",
      "value": 90
    },
    {
      "type": "sort",
      "field": "date"
    }
  ],
  "fields": {
    "date": {
      "label": "Due",
      "format": {
        "type": "date"
      }
    },
    "daysLeft": {
      "label": "Days left"
    },
    "regulation": {
      "label": "Rule"
    },
    "milestone": {
      "label": "Milestone"
    },
    "owner": {
      "label": "Owner"
    },
    "readiness": {
      "label": "Readiness",
      "format": {
        "type": "badge",
        "tones": {
          "Done": "positive",
          "In progress": "warning",
          "Not started": "negative"
        }
      }
    },
    "readinessPct": {
      "label": "Done so far",
      "format": {
        "type": "bar",
        "max": 1,
        "format": {
          "type": "percent"
        }
      }
    },
    "topic": {
      "label": "Topic"
    }
  },
  "view": {
    "type": "table",
    "columns": [
      "date",
      "daysLeft",
      "regulation",
      "milestone",
      "owner",
      "readiness",
      "readinessPct"
    ],
    "pageSize": 10,
    "stickyFirst": true
  },
  "source": {
    "name": "Regulatory watch (fictional)"
  },
  "i18n": {
    "fr": {
      "title": "Échéances à 90 jours",
      "subtitle": "Chaque jalon, le plus proche d'abord, avec responsable et préparation",
      "description": "La liste du responsable conformité : chaque échéance des 90 prochains jours, sa règle, l'équipe responsable, et si le travail est fait, en cours ou pas commencé.",
      "fields": {
        "date": {
          "label": "Échéance"
        },
        "daysLeft": {
          "label": "Jours restants"
        },
        "regulation": {
          "label": "Règle"
        },
        "milestone": {
          "label": "Jalon"
        },
        "owner": {
          "label": "Responsable"
        },
        "readiness": {
          "label": "Préparation"
        },
        "readinessPct": {
          "label": "Fait à ce jour"
        },
        "topic": {
          "label": "Thème"
        }
      },
      "source": {
        "name": "Veille réglementaire (fictive)"
      }
    },
    "de": {
      "title": "Fällig in den nächsten 90 Tagen",
      "subtitle": "Jeder Meilenstein, nächster zuerst, mit Verantwortlichen und Bereitschaft",
      "description": "Die Liste der Compliance-Verantwortlichen: jede Frist der nächsten 90 Tage, ihre Vorschrift, das zuständige Team und ob die Arbeit erledigt, laufend oder nicht begonnen ist.",
      "fields": {
        "date": {
          "label": "Fällig"
        },
