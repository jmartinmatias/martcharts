{
  "id": "reg-topic-horizon",
  "title": "Events per topic",
  "subtitle": "Quarterly events against a baseline of ten, 2024 to 2027",
  "description": "Every topic in a thin row: blue where a quarter brought more than ten events, red where fewer; deeper color, further from ten.",
  "locale": "en-US",
  "data": {
    "type": "url",
    "url": "/data/regulatory-activity.json"
  },
  "transform": [
    {
      "type": "pivot",
      "row": "quarter",
      "column": "topic",
      "value": "events",
      "op": "sum",
      "fill": 0
    }
  ],
  "fields": {
    "quarter": {
      "label": "Quarter"
    }
  },
  "view": {
    "type": "horizon",
    "x": "quarter",
    "y": [
      "Operational resilience",
      "AML & sanctions",
      "ESG & sustainability",
      "Prudential",
      "Consumer protection",
      "Markets",
      "Payments",
      "Data, AI & digital"
    ],
    "baseline": 10,
    "baselineLabel": "ten events"
  },
  "source": {
    "name": "Regulatory watch (fictional)"
  },
  "byline": "Compliance office"
}
