{
  "id": "reg-pressure-kpi",
  "title": "Pressure index",
  "subtitle": "{last:month}, 0 to 100",
  "description": "A composite of new obligations, open consultations and application dates ahead, against the month before.",
  "locale": "en-US",
  "data": {
    "type": "url",
    "url": "/data/regulatory-pressure.json"
  },
  "transform": [
    {
      "type": "filter",
      "field": "forecast",
      "op": "==",
      "value": false
    }
  ],
  "fields": {
    "month": {
      "label": "Month",
      "format": {
        "type": "date",
        "style": "month"
      }
    },
    "pressureIndex": {
      "label": "Pressure index",
      "format": {
        "type": "number",
        "decimals": 1
      }
    }
  },
  "view": {
    "type": "kpi",
    "value": "pressureIndex",
    "series": true,
    "x": "month",
    "goodWhen": "down"
  },
  "source": {
    "name": "Regulatory watch (fictional)"
  },
  "byline": "Compliance office"
}
