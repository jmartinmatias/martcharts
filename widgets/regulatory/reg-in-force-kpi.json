{
  "id": "reg-in-force-kpi",
  "title": "Rules in force",
  "subtitle": "Status today: in effect or applying",
  "description": "How many of the tracked regulations are in force or applying today.",
  "locale": "en-US",
  "data": {
    "type": "url",
    "url": "/data/regulations.json"
  },
  "transform": [
    {
      "type": "filter",
      "field": "status",
      "op": "in",
      "value": [
        "In force",
        "Applies"
      ]
    },
    {
      "type": "aggregate",
      "measures": [
        {
          "op": "count",
          "as": "count"
        }
      ]
    }
  ],
  "fields": {
    "count": {
      "label": "Regulations"
    }
  },
  "view": {
    "type": "kpi",
    "value": "count",
    "icon": "check"
  },
  "source": {
    "name": "Regulatory watch (fictional)"
  }
}
