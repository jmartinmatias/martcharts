{
  "id": "gross-profit",
  "title": "Gross profit",
  "subtitle": "{first:month} to {last:month}",
  "description": "Revenue minus cost, month by month.",
  "note": "Gross profit = revenue - cost",
  "source": {"name": "Finance ledger"},
  "locale": "en-US",
  "data": {
    "type": "url",
    "url": "/data/monthly.json"
  },
  "transform": [
    {
      "type": "calc",
      "as": "profit",
      "op": "subtract",
      "left": "revenue",
      "right": "cost"
    }
  ],
  "fields": {
    "month": {
      "label": "Month",
      "format": {
        "type": "date",
        "style": "month"
      }
    },
    "profit": {
      "label": "Gross profit",
      "format": {
        "type": "currency",
        "currency": "EUR",
        "decimals": 0
      }
    }
  },
  "headline": {
    "value": "profit",
    "compare": "previous",
    "compareLabel": "vs Aug",
    "caption": "gross profit in {last:month}"
  },
  "view": {
    "type": "area",
    "x": "month",
    "y": "profit"
  },
  "i18n": {
    "fr": {
      "title": "Marge brute",
      "subtitle": "{first:month} à {last:month}",
      "description": "Chiffre d'affaires moins coûts, mois par mois.",
      "note": "Marge brute = CA - coûts",
      "source": {
        "name": "Grand livre"
      },
      "fields": {
        "month": {
          "label": "Mois"
        },
        "profit": {
          "label": "Marge brute"
        }
      },
      "headline": {
        "compareLabel": "vs août",
        "caption": "marge brute de {last:month}"
      }
    },
    "de": {
      "title": "Bruttogewinn",
      "subtitle": "{first:month} bis {last:month}",
      "description": "Umsatz minus Kosten, Monat für Monat.",
      "note": "Bruttogewinn = Umsatz - Kosten",
      "source": {
        "name": "Hauptbuch"
      },
      "fields": {
        "month": {
          "label": "Monat"
        },
        "profit": {
          "label": "Bruttogewinn"
        }
      },
      "headline": {
        "compareLabel": "ggü. Aug.",
        "caption": "Bruttogewinn im {last:month}"
      }
    }
  }
}
