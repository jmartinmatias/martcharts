{
  "id": "q3-at-a-glance",
  "title": "At a glance",
  "subtitle": "{last:month} against the month before, with trends from {first:month}",
  "description": "The four headline numbers in one row.",
  "source": {
    "name": "Finance ledger and CRM"
  },
  "locale": "en-US",
  "data": {
    "type": "url",
    "url": "/data/monthly-by-region.json"
  },
  "transform": [
    {
      "type": "aggregate",
      "groupBy": "month",
      "measures": [
        { "op": "sum", "field": "revenue", "as": "revenue" },
        { "op": "sum", "field": "cost", "as": "cost" },
        { "op": "sum", "field": "target", "as": "target" },
        { "op": "sum", "field": "newCustomers", "as": "newCustomers" },
        { "op": "sum", "field": "clients", "as": "clients" },
        { "op": "sum", "field": "churned", "as": "churned" }
      ]
    },
    {
      "type": "calc",
      "as": "churn",
      "op": "divide",
      "left": "churned",
      "right": "clients"
    },
    {
      "type": "calc",
      "as": "profit",
      "op": "subtract",
      "left": "revenue",
      "right": "cost"
    }
  ],
  "fields": {
    "revenue": {
      "label": "Revenue",
      "format": {
        "type": "currency",
        "currency": "EUR",
        "compact": true,
        "decimals": 2
      }
    },
    "profit": {
      "label": "Gross profit",
      "format": {
        "type": "currency",
        "currency": "EUR",
        "compact": true
      }
    },
    "newCustomers": {
      "label": "New customers",
      "format": "number"
    },
    "churn": {
      "label": "Churn",
      "format": {
        "type": "percent",
        "decimals": 1
      }
    },
    "month": {
      "label": "Month",
      "format": {
        "type": "date",
        "style": "month"
      }
    }
  },
  "view": {
    "type": "kpis",
    "series": true,
    "items": [
      {
        "value": "revenue",
        "target": "target"
      },
      {
        "value": "profit"
      },
      {
        "value": "newCustomers"
      },
      {
        "value": "churn",
        "goodWhen": "down"
      }
    ]
  }
}
