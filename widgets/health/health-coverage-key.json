{
  "id": "health-coverage-key",
  "locale": "en-US",
  "source": {
    "name": "Client health model (fictional)"
  },
  "title": "Days since the last meeting, by banker",
  "subtitle": "Average across each book",
  "description": "The key coverage measure, averaged over each banker's clients, against the thresholds that set its status.",
  "data": {
    "type": "url",
    "url": "/data/client-health.json"
  },
  "transform": [
    {
      "type": "aggregate",
      "groupBy": "rm",
      "measures": [
        {
          "op": "avg",
          "field": "daysSinceMeeting"
        }
      ]
    },
    {
      "type": "sort",
      "field": "daysSinceMeeting",
      "order": "desc"
    }
  ],
  "fields": {
    "rm": {
      "label": "Relationship manager"
    },
    "daysSinceMeeting": {
      "label": "Days since meeting",
      "format": {
        "type": "number",
        "decimals": 0
      }
    }
  },
  "view": {
    "type": "bar",
    "x": "rm",
    "y": "daysSinceMeeting",
    "reference": [
      {
        "value": 45,
        "label": "Green up to 45 days"
      },
      {
        "value": 90,
        "label": "Amber up to 90 days"
      }
    ]
  },
  "i18n": {
    "fr": {
      "source": {
        "name": "Modèle de santé client (fictif)"
      },
      "title": "Jours depuis le dernier rendez-vous, par chargé",
      "subtitle": "Moyenne par portefeuille",
      "description": "La mesure clé de couverture, moyennée sur les clients de chaque chargé, face aux seuils qui fixent son statut.",
      "fields": {
        "rm": {
          "label": "Chargé de clientèle"
        },
        "daysSinceMeeting": {
          "label": "Jours depuis le rendez-vous"
        }
      },
      "view": {
        "reference": [
          {
            "label": "Vert jusqu'à 45 jours"
          },
          {
            "label": "Orange jusqu'à 90 jours"
          }
        ]
      }
    },
    "de": {
      "source": {
        "name": "Kundengesundheitsmodell (fiktiv)"
      },
      "title": "Tage seit dem letzten Termin, je Berater",
      "subtitle": "Mittel je Bestand",
      "description": "Die zentrale Betreuungskennzahl, gemittelt über die Kunden jedes Beraters, gegen die Schwellen ihres Status.",
      "fields": {
        "rm": {
          "label": "Kundenberater"
        },
        "daysSinceMeeting": {
          "label": "Tage seit Termin"
        }
      },
      "view": {
        "reference": [
          {
            "label": "Grün bis 45 Tage"
          },
          {
            "label": "Gelb bis 90 Tage"
          }
        ]
      }
    }
  }
}
