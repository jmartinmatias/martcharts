          "No data": "neutral"
        }
      }
    },
    "coverageStatus": {
      "label": "Coverage",
      "format": {
        "type": "badge",
        "tones": {
          "Red": "negative",
          "Amber": "warning",
          "Green": "positive",
          "No data": "neutral"
        }
      }
    },
    "relationshipStatus": {
      "label": "Relationship",
      "format": {
        "type": "badge",
        "tones": {
          "Red": "negative",
          "Amber": "warning",
          "Green": "positive",
          "No data": "neutral"
        }
      }
    }
