{
  "id": "health-relationship-table",
  "locale": "en-US",
  "source": {
    "name": "Client health model (fictional)"
  },
  "title": "Relationship health, client by client",
  "subtitle": "Worst first; search by client, banker or segment",
  "description": "Every client's relationship measures and status, worst overall status first.",
  "data": {
    "type": "url",
    "url": "/data/client-health.json"
  },
  "transform": [
    {
      "type": "sort",
      "field": "priority",
      "order": "desc"
    }
  ],
  "fields": {
    "name": {
      "label": "Client"
    },
    "rm": {
      "label": "Relationship manager"
    },
    "segment": {
      "label": "Segment"
    },
    "region": {
      "label": "Region"
    },
    "aum": {
      "label": "AuM",
      "format": {
        "type": "currency",
        "currency": "EUR",
        "compact": true
      }
    },
    "walletTrend": {
      "label": "Wallet share, 12 months",
      "format": {
        "type": "percent",
        "decimals": 1
      }
    },
    "attritionRisk": {
      "label": "Attrition risk"
    },
    "feeLeakage": {
      "label": "Fee leakage",
      "format": {
        "type": "percent",
        "decimals": 1
      }
    },
    "kycDays": {
      "label": "Days to KYC refresh"
    },
    "sentiment": {
      "label": "Sentiment",
      "format": {
        "type": "number",
        "decimals": 2
      }
    },
    "relationshipStatus": {
      "label": "Relationship",
      "format": {
        "type": "badge",
        "tones": {
          "Red": "negative",
          "Amber": "warning",
          "Green": "positive",
          "No data": "neutral"
        }
      }
    },
    "overallStatus": {
      "label": "Overall",
      "format": {
        "type": "badge",
        "tones": {
          "Red": "negative",
          "Amber": "warning",
          "Green": "positive",
          "No data": "neutral"
        }
      }
    }
  },
  "view": {
    "type": "table",
    "columns": [
      "name",
      "rm",
      "walletTrend",
      "attritionRisk",
      "feeLeakage",
      "kycDays",
      "sentiment",
      "relationshipStatus"
    ],
    "search": true,
    "pageSize": 10,
    "stickyFirst": true
  }
}
