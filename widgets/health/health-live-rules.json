{
  "id": "health-live-rules",
  "locale": "en-US",
  "source": {
    "name": "Client health model (fictional)"
  },
  "title": "Statuses worked out live",
  "subtitle": "NPS, meeting gaps and attrition risk scored from their thresholds as the data loads",
  "description": "The same statuses computed in the browser from the raw values by the rag transform, so any data can be scored with written rules.",
  "data": {
    "type": "url",
    "url": "/data/client-health.json"
  },
  "transform": [
    {
      "type": "rag",
      "rules": [
        {
          "field": "nps",
          "as": "npsLive",
          "green": 30,
          "amber": 0
        },
        {
          "field": "daysSinceMeeting",
          "as": "meetingLive",
          "green": 45,
          "amber": 90,
          "goodWhen": "down"
        },
        {
          "field": "attritionRisk",
          "as": "attritionLive",
          "green": 30,
          "amber": 60,
          "goodWhen": "down"
        }
      ],
      "overall": "liveOverall"
    }
  ],
  "fields": {
    "name": {
      "label": "Client"
    },
    "nps": {
      "label": "NPS"
    },
    "npsLive": {
      "label": "NPS status",
      "format": {
        "type": "rag"
      }
    },
    "daysSinceMeeting": {
      "label": "Days since meeting"
    },
    "meetingLive": {
      "label": "Meeting status",
      "format": {
        "type": "rag"
      }
    },
    "attritionRisk": {
      "label": "Attrition risk"
    },
    "attritionLive": {
      "label": "Attrition status",
      "format": {
        "type": "rag"
      }
    },
    "liveOverall": {
      "label": "Together",
      "format": {
        "type": "rag"
      }
    }
  },
  "view": {
    "type": "table",
    "columns": [
      "name",
      "nps",
      "npsLive",
      "daysSinceMeeting",
      "meetingLive",
      "attritionRisk",
      "attritionLive",
      "liveOverall"
    ],
    "search": true,
    "pageSize": 10
  }
}
