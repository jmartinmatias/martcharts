{
  "id": "health-books",
  "locale": "en-US",
  "source": {
    "name": "Client health model (fictional)"
  },
  "title": "Each banker's book",
  "subtitle": "Clients overall, and off track per perspective",
  "description": "One row per relationship manager, counted from the clients themselves, so the segment and region filters reach it.",
  "data": {
    "type": "url",
    "url": "/data/client-health.json"
  },
  "transform": [
    {
      "type": "aggregate",
      "groupBy": "rm",
      "measures": [
        {
          "op": "count",
          "as": "clients"
        },
        {
          "op": "sum",
          "field": "overallRed",
          "as": "red"
        },
        {
          "op": "sum",
          "field": "overallAmber",
          "as": "amber"
        },
        {
          "op": "sum",
          "field": "overallGreen",
          "as": "green"
        },
        {
          "op": "sum",
          "field": "clientSuccessRed",
          "as": "clientSuccessRed"
        },
        {
          "op": "sum",
          "field": "bizDevRed",
          "as": "bizDevRed"
        },
        {
          "op": "sum",
          "field": "coverageRed",
          "as": "coverageRed"
        },
        {
          "op": "sum",
          "field": "relationshipRed",
          "as": "relationshipRed"
        }
      ]
    },
    {
      "type": "sort",
      "field": "red",
      "order": "desc"
    }
  ],
  "fields": {
    "rm": {
      "label": "Relationship manager"
    },
    "clients": {
      "label": "Clients"
    },
    "red": {
      "label": "Off track"
    },
    "amber": {
      "label": "At risk"
    },
    "green": {
      "label": "On track"
    },
    "clientSuccessRed": {
      "label": "Off track: client success"
    },
    "bizDevRed": {
      "label": "Off track: business development"
    },
    "coverageRed": {
      "label": "Off track: coverage"
    },
    "relationshipRed": {
      "label": "Off track: relationship"
    }
  },
  "view": {
    "type": "table",
    "columns": [
      "rm",
      "clients",
      "red",
      "amber",
      "green",
      "clientSuccessRed",
      "bizDevRed",
      "coverageRed",
      "relationshipRed"
    ],
    "stickyFirst": true
  }
}
