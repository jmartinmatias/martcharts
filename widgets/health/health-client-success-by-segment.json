{
  "id": "health-client-success-by-segment",
  "locale": "en-US",
  "source": {
    "name": "Client health model (fictional)"
  },
  "title": "How clients are served",
  "subtitle": "Success status by segment",
  "description": "How many clients in each segment are green, amber or red on client success.",
  "data": {
    "type": "url",
    "url": "/data/client-health.json"
  },
  "transform": [
    {
      "type": "pivot",
      "row": "segment",
      "column": "clientSuccessStatus",
      "value": "id",
      "op": "count",
      "fill": 0
    }
  ],
  "fields": {
    "segment": {
      "label": "Segment"
    },
    "Red": {
      "label": "Off track (red)"
    },
    "Amber": {
      "label": "To watch (amber)"
    },
    "Green": {
      "label": "On track (green)"
    }
  },
  "view": {
    "type": "hbar",
    "label": "segment",
    "value": [
      "Red",
      "Amber",
      "Green"
    ],
    "stacked": true
  },
  "style": {
    "palette": [
      "#D1453B",
      "#E0A21B",
      "#2E9D5B"
    ]
  },
  "i18n": {
    "fr": {
      "source": {
        "name": "Modèle de santé client (fictif)"
      },
      "title": "Comment les clients sont servis",
      "subtitle": "Statut succès client par segment",
      "description": "Combien de clients par segment sont verts, orange ou rouges en succès client.",
      "fields": {
        "Red": {
          "label": "Hors trajectoire (rouge)"
        },
        "Amber": {
          "label": "À surveiller (orange)"
        },
        "Green": {
          "label": "Sur la bonne voie (vert)"
        },
        "segment": {
          "values": {
            "Private": "Banque privée",
            "Affluent": "Clientèle aisée",
            "Corporate": "Entreprises",
            "Institutional": "Institutionnels"
          }
        }
      }
    },
    "de": {
      "source": {
        "name": "Kundengesundheitsmodell (fiktiv)"
      },
      "title": "Wie Kunden betreut werden",
      "subtitle": "Kundenerfolgsstatus nach Segment",
      "description": "Wie viele Kunden je Segment beim Kundenerfolg grün, gelb oder rot sind.",
      "fields": {
        "Red": {
          "label": "Nicht im Plan (rot)"
        },
        "Amber": {
          "label": "Beobachten (gelb)"
        },
        "Green": {
          "label": "Im Plan (grün)"
        },
        "segment": {
          "values": {
            "Private": "Privatkunden",
            "Affluent": "Vermögende Kunden",
            "Corporate": "Firmenkunden",
            "Institutional": "Institutionelle"
          }
        }
      }
    }
  }
}
