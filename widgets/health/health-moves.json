{
  "id": "health-moves",
  "locale": "en-US",
  "source": {
    "name": "Client health model (fictional)"
  },
  "title": "What changed this quarter",
  "subtitle": "Clients by overall status, last period to now",
  "description": "Each band is a group of clients moving from last quarter's overall status to this quarter's; a band that stays level held its status.",
  "data": {
    "type": "url",
    "url": "/data/client-health.json"
  },
  "fields": {
    "from": {
      "label": "Last quarter"
    },
    "to": {
      "label": "This quarter"
    },
    "clients": {
      "label": "Clients"
    }
  },
  "view": {
    "type": "sankey",
    "source": "movedFrom",
    "target": "movedTo",
    "value": "clients"
  },
  "style": {
    "palette": [
      "#2E9D5B",
      "#E0A21B",
      "#D1453B"
    ]
  },
  "transform": [
    {
      "type": "aggregate",
      "groupBy": [
        "movedFrom",
        "movedTo"
      ],
      "measures": [
        {
          "op": "count",
          "as": "clients"
        }
      ]
    },
    {
      "type": "sort",
      "field": "clients",
      "order": "desc"
    }
  ]
}
