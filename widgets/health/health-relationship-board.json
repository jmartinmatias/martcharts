{
  "id": "health-relationship-board",
  "locale": "en-US",
  "source": {
    "name": "Client health model (fictional)"
  },
  "title": "Relationship health, measure by measure",
  "subtitle": "The clients off track or at risk on relationship health, worst first, with the move since last quarter. Clients on track are left out; the table below lists everyone.",
  "description": "The relationship scorecard: one row per client, one status per measure, the perspective's status and its move since last quarter, and the next step.",
  "data": {
    "type": "url",
    "url": "/data/client-health.json"
  },
  "fields": {
    "name": {
      "label": "Client"
    },
    "rm": {
      "label": "Relationship manager"
    },
    "segment": {
      "label": "Segment"
    },
    "region": {
      "label": "Region"
    },
    "aum": {
      "label": "AuM",
      "format": {
        "type": "currency",
        "currency": "EUR",
        "compact": true
      }
    },
    "relationshipRag": {
      "label": "Relationship"
    },
    "walletTrendRag": {
      "label": "Wallet share, 12 months"
    },
    "attritionRiskRag": {
      "label": "Attrition risk"
    },
    "feeLeakageRag": {
      "label": "Fee leakage"
    },
    "kycDaysRag": {
      "label": "Days to KYC refresh"
    },
    "sentimentRag": {
      "label": "Sentiment"
    },
    "action": {
      "label": "Next step"
    }
  },
  "view": {
    "type": "ragboard",
    "label": "name",
    "dimensions": [
      "walletTrendRag",
      "attritionRiskRag",
      "feeLeakageRag",
      "kycDaysRag",
      "sentimentRag"
    ],
    "overall": "relationshipRag",
    "previous": {
      "relationshipRag": "relationshipPrevRag"
    },
    "sort": "worst",
    "group": "segment",
    "note": "action"
  },
  "transform": [
    {
      "type": "filter",
      "field": "relationshipRag",
      "op": "in",
      "value": [
        "R",
        "A"
      ]
    }
  ]
}
