      "description": "La liste d'actions : une ligne par client hors trajectoire, le rouge avant l'orange, l'action la plus ancienne d'abord.",
      "fields": {
        "rm": {
          "label": "Chargé de clientèle"
        },
        "region": {
          "label": "Région"
        },
        "aum": {
          "label": "Actifs gérés"
        },
        "overallStatus": {
          "label": "Statut"
        },
        "owner": {
          "label": "Responsable"
        },
        "action": {
          "label": "Étape suivante"
        },
        "daysOpen": {
          "label": "Jours ouverts"
        }
      }
    },
    "de": {
