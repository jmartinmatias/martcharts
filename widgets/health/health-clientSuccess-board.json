        "type": "currency",
        "currency": "EUR",
        "compact": true
      }
    },
    "clientSuccessRag": {
      "label": "Client success"
    },
    "onboardingRag": {
      "label": "Onboarding"
    },
    "digitalAdoptionRag": {
      "label": "Digital adoption"
    },
    "ticketsOpenRag": {
      "label": "Tickets open"
