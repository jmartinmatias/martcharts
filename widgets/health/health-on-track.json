{
  "id": "health-on-track",
  "locale": "en-US",
  "source": {
    "name": "Client health model (fictional)"
  },
  "title": "Clients on track",
  "subtitle": "{last:quarter}, against the quarter before",
  "description": "How many clients are green, amber and red overall this quarter, and the share on track, each against last quarter.",
  "data": {
    "type": "url",
    "url": "/data/client-health-history.json"
  },
  "transform": [
    {
      "type": "pivot",
      "row": "quarter",
      "column": "overallStatus",
      "value": "clientId",
      "op": "count",
      "fill": 0
    },
    {
      "type": "calc",
      "as": "watched",
      "op": "add",
      "left": "Green",
      "right": "Amber"
    },
    {
      "type": "calc",
      "as": "clients",
      "op": "add",
      "left": "watched",
      "right": "Red"
    },
    {
      "type": "calc",
      "as": "onTrack",
      "op": "divide",
      "left": "Green",
      "right": "clients"
    }
  ],
  "fields": {
    "quarter": {
      "label": "Quarter",
      "format": {
        "type": "date",
        "style": "quarter"
      }
    },
    "onTrack": {
      "label": "Share on track",
      "format": {
        "type": "percent"
      }
    },
    "Red": {
      "label": "Off track (red)"
    },
    "Amber": {
      "label": "To watch (amber)"
    },
    "Green": {
      "label": "On track (green)"
    }
  },
  "view": {
    "type": "kpis",
    "series": true,
    "items": [
      {
        "value": "onTrack",
        "label": "Share of clients on track",
        "compare": "previous"
      },
      {
        "value": "Green",
        "label": "On track",
        "compare": "previous"
      },
      {
        "value": "Amber",
        "label": "To watch",
        "compare": "previous",
        "goodWhen": "down"
      },
      {
        "value": "Red",
        "label": "Off track",
        "compare": "previous",
        "goodWhen": "down"
      }
    ]
  },
  "i18n": {
    "fr": {
      "source": {
        "name": "Modèle de santé client (fictif)"
      },
      "title": "Clients sur la bonne voie",
      "subtitle": "{last:quarter}, face au trimestre précédent",
      "description": "Combien de clients sont verts, orange et rouges ce trimestre, et la part sur la bonne voie, face au trimestre précédent.",
      "fields": {
        "quarter": {
          "label": "Trimestre"
        },
        "onTrack": {
          "label": "Part sur la bonne voie"
        },
        "Red": {
          "label": "Hors trajectoire (rouge)"
        },
        "Amber": {
          "label": "À surveiller (orange)"
        },
        "Green": {
          "label": "Sur la bonne voie (vert)"
        }
      },
      "view": {
        "items": [
          {
            "label": "Part des clients sur la bonne voie"
          },
          {
            "label": "Sur la bonne voie"
          },
          {
            "label": "À surveiller"
          },
          {
            "label": "Hors trajectoire"
          }
        ]
      }
    },
    "de": {
      "source": {
        "name": "Kundengesundheitsmodell (fiktiv)"
      },
      "title": "Kunden im Plan",
      "subtitle": "{last:quarter} gegen das Vorquartal",
      "description": "Wie viele Kunden dieses Quartal grün, gelb und rot sind und der Anteil im Plan, jeweils gegen das Vorquartal.",
      "fields": {
        "quarter": {
          "label": "Quartal"
        },
        "onTrack": {
          "label": "Anteil im Plan"
        },
        "Red": {
          "label": "Nicht im Plan (rot)"
        },
        "Amber": {
          "label": "Beobachten (gelb)"
        },
        "Green": {
          "label": "Im Plan (grün)"
        }
      },
      "view": {
        "items": [
          {
            "label": "Anteil der Kunden im Plan"
          },
          {
            "label": "Im Plan"
          },
          {
            "label": "Beobachten"
          },
          {
            "label": "Nicht im Plan"
          }
        ]
      }
    }
  }
}
