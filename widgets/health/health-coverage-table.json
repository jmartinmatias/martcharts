{
  "id": "health-coverage-table",
  "locale": "en-US",
  "source": {
    "name": "Client health model (fictional)"
  },
  "title": "Coverage, client by client",
  "subtitle": "Worst first; search by client, banker or segment",
  "description": "Every client's coverage measures and status, worst overall status first.",
  "data": {
    "type": "url",
    "url": "/data/client-health.json"
  },
  "transform": [
    {
      "type": "sort",
      "field": "priority",
      "order": "desc"
    }
  ],
  "fields": {
    "name": {
      "label": "Client"
    },
    "rm": {
      "label": "Relationship manager"
    },
    "segment": {
      "label": "Segment"
    },
    "region": {
      "label": "Region"
    },
    "aum": {
      "label": "AuM",
      "format": {
        "type": "currency",
        "currency": "EUR",
        "compact": true
      }
    },
    "daysSinceMeeting": {
      "label": "Days since meeting"
    },
    "cadence": {
      "label": "Meetings vs plan",
      "format": {
        "type": "percent"
      }
    },
    "rmLoad": {
      "label": "Banker load",
      "format": {
        "type": "percent"
      }
    },
    "reviewOverdue": {
      "label": "Review overdue, days"
    },
    "coverageStatus": {
      "label": "Coverage",
      "format": {
        "type": "badge",
        "tones": {
          "Red": "negative",
          "Amber": "warning",
          "Green": "positive",
          "No data": "neutral"
        }
      }
    },
    "overallStatus": {
      "label": "Overall",
      "format": {
        "type": "badge",
        "tones": {
          "Red": "negative",
          "Amber": "warning",
          "Green": "positive",
          "No data": "neutral"
        }
      }
    }
  },
  "view": {
    "type": "table",
    "columns": [
      "name",
      "rm",
      "daysSinceMeeting",
      "cadence",
      "rmLoad",
      "reviewOverdue",
      "coverageStatus"
    ],
    "search": true,
    "pageSize": 10,
    "stickyFirst": true
  }
}
