{
  "id": "health-biz-dev-key",
  "locale": "en-US",
  "source": {
    "name": "Client health model (fictional)"
  },
  "title": "Pipeline cover by banker",
  "subtitle": "Average open deals against target",
  "description": "The key business development measure, averaged over each banker's clients, against the thresholds that set its status.",
  "data": {
    "type": "url",
    "url": "/data/client-health.json"
  },
  "transform": [
    {
      "type": "aggregate",
      "groupBy": "rm",
      "measures": [
        {
          "op": "avg",
          "field": "pipelineCoverage"
        }
      ]
    },
    {
      "type": "sort",
      "field": "pipelineCoverage",
      "order": "desc"
    }
  ],
  "fields": {
    "rm": {
      "label": "Relationship manager"
    },
    "pipelineCoverage": {
      "label": "Pipeline cover",
      "format": {
        "type": "number",
        "decimals": 1
      }
    }
  },
  "view": {
    "type": "bar",
    "x": "rm",
    "y": "pipelineCoverage",
    "reference": [
      {
        "value": 3,
        "label": "Green from 3×"
      },
      {
        "value": 1.5,
        "label": "Amber from 1.5×"
      }
    ]
  },
  "i18n": {
    "fr": {
      "source": {
        "name": "Modèle de santé client (fictif)"
      },
      "title": "Couverture du pipeline par chargé",
      "subtitle": "Affaires ouvertes moyennes face à l'objectif",
      "description": "La mesure clé du développement commercial, moyennée sur les clients de chaque chargé, face aux seuils qui fixent son statut.",
      "fields": {
        "rm": {
          "label": "Chargé de clientèle"
        },
        "pipelineCoverage": {
          "label": "Couverture du pipeline"
        }
      },
      "view": {
        "reference": [
          {
            "label": "Vert dès 3×"
          },
          {
            "label": "Orange dès 1,5×"
          }
        ]
      }
    },
    "de": {
      "source": {
        "name": "Kundengesundheitsmodell (fiktiv)"
      },
      "title": "Pipeline-Deckung je Berater",
      "subtitle": "Mittlere offene Deals gegen das Ziel",
      "description": "Die zentrale Kennzahl der Geschäftsentwicklung, gemittelt über die Kunden jedes Beraters, gegen die Schwellen ihres Status.",
      "fields": {
        "rm": {
          "label": "Kundenberater"
        },
        "pipelineCoverage": {
          "label": "Pipeline-Deckung"
        }
      },
      "view": {
        "reference": [
          {
            "label": "Grün ab 3×"
          },
          {
            "label": "Gelb ab 1,5×"
          }
        ]
      }
    }
  }
}
