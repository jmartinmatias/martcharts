{
  "id": "health-status-by-segment",
  "locale": "en-US",
  "source": {
    "name": "Client health model (fictional)"
  },
  "title": "Where the book stands",
  "subtitle": "Overall status by segment, share of clients",
  "description": "Each segment's clients split by their overall status, as shares of the segment.",
  "data": {
    "type": "url",
    "url": "/data/client-health.json"
  },
  "transform": [
    {
      "type": "pivot",
      "row": "segment",
      "column": "overallStatus",
      "value": "id",
      "op": "count",
      "fill": 0
    }
  ],
  "fields": {
    "segment": {
      "label": "Segment"
    },
    "Red": {
      "label": "Off track (red)"
    },
    "Amber": {
      "label": "To watch (amber)"
    },
    "Green": {
      "label": "On track (green)"
    }
  },
  "view": {
    "type": "hbar",
    "label": "segment",
    "value": [
      "Red",
      "Amber",
      "Green"
    ],
    "stacked": "percent"
  },
  "style": {
    "palette": [
      "#D1453B",
      "#E0A21B",
      "#2E9D5B"
    ]
  },
  "i18n": {
    "fr": {
      "source": {
        "name": "Modèle de santé client (fictif)"
      },
      "title": "Où en est le portefeuille",
      "subtitle": "Statut global par segment, part des clients",
      "description": "Les clients de chaque segment répartis par statut global, en parts du segment.",
      "fields": {
        "Red": {
          "label": "Hors trajectoire (rouge)"
        },
        "Amber": {
          "label": "À surveiller (orange)"
        },
        "Green": {
          "label": "Sur la bonne voie (vert)"
        }
      }
    },
    "de": {
      "source": {
        "name": "Kundengesundheitsmodell (fiktiv)"
      },
      "title": "Wo der Bestand steht",
      "subtitle": "Gesamtstatus nach Segment, Anteil der Kunden",
      "description": "Kunden jedes Segments nach Gesamtstatus, als Anteile des Segments.",
      "fields": {
        "Red": {
          "label": "Nicht im Plan (rot)"
        },
        "Amber": {
          "label": "Beobachten (gelb)"
        },
        "Green": {
          "label": "Im Plan (grün)"
        }
      }
    }
  }
}
