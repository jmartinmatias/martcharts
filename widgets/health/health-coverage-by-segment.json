{
  "id": "health-coverage-by-segment",
  "locale": "en-US",
  "source": {
    "name": "Client health model (fictional)"
  },
  "title": "Where coverage is slipping",
  "subtitle": "Status by segment, in clients",
  "description": "How many clients in each segment are green, amber or red on coverage.",
  "data": {
    "type": "url",
    "url": "/data/client-health.json"
  },
  "transform": [
    {
      "type": "pivot",
      "row": "segment",
      "column": "coverageStatus",
      "value": "id",
      "op": "count",
      "fill": 0
    }
  ],
  "fields": {
    "segment": {
      "label": "Segment"
    },
    "Red": {
      "label": "Off track (red)"
    },
    "Amber": {
      "label": "To watch (amber)"
    },
    "Green": {
      "label": "On track (green)"
    }
  },
  "view": {
    "type": "hbar",
    "label": "segment",
    "value": [
      "Red",
      "Amber",
      "Green"
    ],
    "stacked": true
  },
  "style": {
    "palette": [
      "#D1453B",
      "#E0A21B",
      "#2E9D5B"
    ]
  },
  "i18n": {
    "fr": {
      "source": {
        "name": "Modèle de santé client (fictif)"
      },
      "title": "Où la couverture se dégrade",
      "subtitle": "Statut par segment, en clients",
      "description": "Combien de clients par segment sont verts, orange ou rouges en couverture.",
      "fields": {
        "Red": {
          "label": "Hors trajectoire (rouge)"
        },
        "Amber": {
          "label": "À surveiller (orange)"
        },
        "Green": {
          "label": "Sur la bonne voie (vert)"
        }
      }
    },
    "de": {
      "source": {
        "name": "Kundengesundheitsmodell (fiktiv)"
      },
      "title": "Wo die Betreuung nachlässt",
      "subtitle": "Status nach Segment, in Kunden",
      "description": "Wie viele Kunden je Segment bei der Betreuung grün, gelb oder rot sind.",
      "fields": {
        "Red": {
          "label": "Nicht im Plan (rot)"
        },
        "Amber": {
          "label": "Beobachten (gelb)"
        },
        "Green": {
          "label": "Im Plan (grün)"
        }
      }
    }
  }
}
