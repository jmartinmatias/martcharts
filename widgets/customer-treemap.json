{
  "id": "customer-treemap",
  "title": "Revenue by customer",
  "subtitle": "Year to date, by segment",
  "description": "Every customer's share of revenue, grouped by segment.",
  "source": {
    "name": "CRM"
  },
  "locale": "en-US",
  "data": {
    "type": "url",
    "url": "/data/customers.json"
  },
  "transform": [
    {
      "type": "sort",
      "field": "revenue",
      "order": "desc"
    }
  ],
  "fields": {
    "revenue": {
      "label": "Revenue",
      "format": {
        "type": "currency",
        "currency": "EUR",
        "compact": true
      }
    },
    "segment": {
      "label": "Segment"
    }
  },
  "view": {
    "type": "treemap",
    "label": "name",
    "value": "revenue",
    "group": "segment"
  },
  "i18n": {
    "fr": {
      "title": "CA par client",
      "subtitle": "Depuis janvier, par segment",
      "description": "La part de CA de chaque client, groupée par segment.",
      "fields": {
        "revenue": {
          "label": "Chiffre d'affaires"
        },
        "segment": {
          "values": {
            "Enterprise": "Grandes entreprises",
            "Mid-market": "ETI",
            "Small business": "Petites entreprises"
          }
        }
      }
    },
    "de": {
      "title": "Umsatz je Kunde",
      "subtitle": "Seit Jahresbeginn, nach Segment",
      "description": "Umsatzanteil jedes Kunden, nach Segment gruppiert.",
      "fields": {
        "revenue": {
          "label": "Umsatz"
        },
        "segment": {
          "values": {
            "Enterprise": "Großunternehmen",
            "Mid-market": "Mittelstand",
            "Small business": "Kleinunternehmen"
          }
        }
      }
    }
  }
}
