{
  "id": "cc-product-mix",
  "title": "Where revenue comes from",
  "subtitle": "The six biggest products, 2026 year to date",
  "description": "The revenue mix across the six biggest products.",
  "locale": "en-US",
  "source": {
    "name": "Commercial data mart (fictional)"
  },
  "data": {
    "type": "url",
    "url": "/data/holdings.json"
  },
  "transform": [
    {
      "type": "aggregate",
      "groupBy": "product",
      "measures": [
        {
          "op": "sum",
          "field": "revenue",
          "as": "revenue"
        }
      ]
    },
    {
      "type": "sort",
      "field": "revenue",
      "order": "desc"
    },
    {
      "type": "limit",
      "count": 6
    }
  ],
  "fields": {
    "product": {
      "label": "Product"
    },
    "revenue": {
      "label": "Revenue",
      "format": {
        "type": "currency",
        "currency": "EUR",
        "compact": true
      }
    }
  },
  "view": {
    "type": "pie",
    "label": "product",
    "value": "revenue"
  }
}
