{
  "id": "cc-new-money-target",
  "title": "Net new money against target, by banker",
  "subtitle": "2026 year to date, over or under each plan",
  "description": "Net new money each relationship manager brought in this year, against the plan.",
  "locale": "en-US",
  "source": {
    "name": "Commercial data mart (fictional)"
  },
  "data": {
    "type": "url",
    "url": "/data/pipeline-by-book.json"
  },
  "transform": [
    {
      "type": "aggregate",
      "groupBy": "rm",
      "measures": [
        {
          "op": "sum",
          "field": "newMoney",
          "as": "newMoney"
        },
        {
          "op": "sum",
          "field": "newMoneyTarget",
          "as": "newMoneyTarget"
        }
      ]
    }
  ],
  "fields": {
    "rm": {
      "label": "Relationship manager"
    },
    "newMoney": {
      "label": "Net new money",
      "format": {
        "type": "currency",
        "currency": "EUR",
        "compact": true
      }
    },
    "newMoneyTarget": {
      "label": "Target",
      "format": {
        "type": "currency",
        "currency": "EUR",
        "compact": true
      }
    }
  },
  "view": {
    "type": "variance",
    "label": "rm",
    "value": "newMoney",
    "target": "newMoneyTarget",
    "percent": true
  },
  "i18n": {
    "fr": {
      "title": "Collecte nette face à l'objectif, par chargé",
      "subtitle": "2026 depuis janvier, au-dessus ou en dessous du plan",
      "description": "Collecte nette de chaque chargé de clientèle cette année, face au plan.",
      "source": {
        "name": "Datamart commercial (fictif)"
      },
      "fields": {
        "rm": {
          "label": "Chargé de clientèle"
        },
        "newMoney": {
          "label": "Collecte nette"
        },
        "newMoneyTarget": {
          "label": "Objectif"
        }
      }
    },
    "de": {
      "title": "Netto-Neugeld gegen Ziel, je Berater",
      "subtitle": "2026 seit Jahresbeginn, über oder unter jedem Plan",
      "description": "Netto-Neugeld jedes Kundenberaters in diesem Jahr gegen den Plan.",
      "source": {
        "name": "Vertriebs-Data-Mart (fiktiv)"
      },
      "fields": {
        "rm": {
          "label": "Kundenberater"
        },
        "newMoney": {
          "label": "Netto-Neugeld"
        },
        "newMoneyTarget": {
          "label": "Ziel"
        }
      }
    }
  }
}
