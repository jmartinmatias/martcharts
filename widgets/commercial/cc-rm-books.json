{
  "id": "cc-rm-books",
  "title": "Books by relationship manager",
  "subtitle": "Assets, revenue and meetings",
  "description": "Each relationship manager's book in numbers.",
  "locale": "en-US",
  "source": {
    "name": "Commercial data mart (fictional)"
  },
  "data": {
    "type": "url",
    "url": "/data/clients.json"
  },
  "transform": [
    {
      "type": "aggregate",
      "groupBy": [
        "rm",
        "office"
      ],
      "measures": [
        {
          "op": "count",
          "as": "clients"
        },
        {
          "op": "sum",
          "field": "aum",
          "as": "aum"
        },
        {
          "op": "sum",
          "field": "revenue",
          "as": "revenue"
        },
        {
          "op": "sum",
          "field": "meetingsYtd",
          "as": "meetingsYtd"
        }
      ]
    },
    {
      "type": "sort",
      "field": "aum",
      "order": "desc"
    }
  ],
  "fields": {
    "rm": {
      "label": "Relationship manager"
    },
    "office": {
      "label": "Office"
    },
    "clients": {
      "label": "Clients"
    },
    "aum": {
      "label": "AuM",
      "format": {
        "type": "bar",
        "format": {
          "type": "currency",
          "currency": "EUR",
          "compact": true
        }
      }
    },
    "revenue": {
      "label": "Revenue",
      "format": {
        "type": "currency",
        "currency": "EUR",
        "compact": true
      }
    },
    "meetingsYtd": {
      "label": "Meetings",
      "format": {
        "type": "heat"
      }
    }
  },
  "view": {
    "type": "table",
    "columns": [
      "rm",
      "office",
      "clients",
      "aum",
      "revenue",
      "meetingsYtd"
    ]
  },
  "i18n": {
    "fr": {
      "title": "Portefeuilles par chargé de clientèle",
      "subtitle": "Actifs, CA et rendez-vous",
      "description": "Le portefeuille de chaque chargé de clientèle en chiffres.",
      "source": {
        "name": "Datamart commercial (fictif)"
      },
      "fields": {
        "rm": {
          "label": "Chargé de clientèle"
        },
        "office": {
          "label": "Bureau"
        },
        "aum": {
          "label": "Actifs gérés"
        },
        "revenue": {
          "label": "Chiffre d'affaires"
        },
        "meetingsYtd": {
          "label": "Rendez-vous"
        }
      }
    },
    "de": {
      "title": "Bestände je Kundenberater",
      "subtitle": "Vermögen, Umsatz und Termine",
      "description": "Der Bestand jedes Kundenberaters in Zahlen.",
      "source": {
        "name": "Vertriebs-Data-Mart (fiktiv)"
      },
      "fields": {
        "rm": {
          "label": "Kundenberater"
        },
        "office": {
          "label": "Büro"
        },
        "clients": {
          "label": "Kunden"
        },
        "revenue": {
          "label": "Umsatz"
        },
        "meetingsYtd": {
          "label": "Termine"
        }
      }
    }
  }
}
