{
  "id": "cc-fees-variance",
  "title": "Fees against target",
  "subtitle": "By segment, 2026 year to date",
  "description": "Fee income per segment against its target.",
  "locale": "en-US",
  "source": {
    "name": "Commercial data mart (fictional)"
  },
  "data": {
    "type": "url",
    "url": "/data/fees-by-book.json"
  },
  "fields": {
    "segment": {
      "label": "Segment"
    },
    "fees": {
      "label": "Fees",
      "format": {
        "type": "currency",
        "currency": "EUR",
        "compact": true
      }
    },
    "target": {
      "label": "Target",
      "format": {
        "type": "currency",
        "currency": "EUR",
        "compact": true
      }
    }
  },
  "view": {
    "type": "variance",
    "label": "segment",
    "value": "fees",
    "target": "target",
    "percent": true
  },
  "transform": [
    {
      "type": "aggregate",
      "groupBy": "segment",
      "measures": [
        {
          "op": "sum",
          "field": "fees",
          "as": "fees"
        },
        {
          "op": "sum",
          "field": "target",
          "as": "target"
        }
      ]
    }
  ],
  "i18n": {
    "fr": {
      "title": "Commissions face à l'objectif",
      "subtitle": "Par segment, depuis janvier 2026",
      "description": "Commissions par segment, face à leur objectif.",
      "source": {
        "name": "Datamart commercial (fictif)"
      },
      "fields": {
        "fees": {
          "label": "Commissions"
        },
        "target": {
          "label": "Objectif"
        }
      }
    },
    "de": {
      "title": "Gebühren gegen Ziel",
      "subtitle": "Nach Segment, 2026 seit Jahresbeginn",
      "description": "Provisionserträge je Segment gegen ihr Ziel.",
      "source": {
        "name": "Vertriebs-Data-Mart (fiktiv)"
      },
      "fields": {
        "fees": {
          "label": "Gebühren"
        },
        "target": {
          "label": "Ziel"
        }
      }
    }
  }
}
