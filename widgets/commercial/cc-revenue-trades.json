{
  "id": "cc-revenue-trades",
  "title": "Revenue and trades",
  "subtitle": "{first:month} to {last:month}: twelve months, so it runs longer than the year-to-date revenue above, each on its own scale",
  "description": "Monthly revenue and the number of trades behind it.",
  "locale": "en-US",
  "source": {
    "name": "Commercial data mart (fictional)"
  },
  "data": {
    "type": "url",
    "url": "/data/client-activity.json"
  },
  "transform": [
    {
      "type": "aggregate",
      "groupBy": "month",
      "measures": [
        {
          "op": "sum",
          "field": "revenue",
          "as": "revenue"
        },
        {
          "op": "sum",
          "field": "trades",
          "as": "trades"
        }
      ]
    },
    {
      "type": "sort",
      "field": "month"
    }
  ],
  "fields": {
    "month": {
      "label": "Month",
      "format": {
        "type": "date",
        "style": "month"
      }
    },
    "revenue": {
      "label": "Revenue",
      "format": {
        "type": "currency",
        "currency": "EUR",
        "compact": true
      }
    },
    "trades": {
      "label": "Trades"
    }
  },
  "view": {
    "type": "dual",
    "x": "month",
    "y": "revenue",
    "y2": "trades",
    "marks": [
      "bar",
      "line"
    ]
  }
}
