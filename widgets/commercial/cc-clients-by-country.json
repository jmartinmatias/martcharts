{
  "id": "cc-clients-by-country",
  "title": "Where clients are",
  "subtitle": "By country, active book",
  "description": "How many clients each country has, as circles on the map.",
  "locale": "en-US",
  "source": {
    "name": "Commercial data mart (fictional)"
  },
  "data": {
    "type": "url",
    "url": "/data/clients.json"
  },
  "transform": [
    {
      "type": "aggregate",
      "groupBy": "country",
      "measures": [
        {
          "op": "count",
          "as": "clients"
        }
      ]
    }
  ],
  "fields": {
    "country": {
      "label": "Country"
    },
    "clients": {
      "label": "Clients"
    }
  },
  "view": {
    "type": "symbols",
    "geo": "europe",
    "id": "country",
    "size": "clients"
  }
}
