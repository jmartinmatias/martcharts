{
  "id": "cc-product-revenue",
  "title": "Revenue by product",
  "subtitle": "2026 year to date; the products add up to the book's revenue",
  "description": "Each product's revenue as a tile: the bigger the tile, the more it brings.",
  "locale": "en-US",
  "source": {
    "name": "Commercial data mart (fictional)"
  },
  "data": {
    "type": "url",
    "url": "/data/holdings.json"
  },
  "fields": {
    "product": {
      "label": "Product"
    },
    "revenue": {
      "label": "Revenue",
      "format": {
        "type": "currency",
        "currency": "EUR",
        "compact": true
      }
    }
  },
  "view": {
    "type": "treemap",
    "label": "product",
    "value": "revenue"
  },
  "transform": [
    {
      "type": "aggregate",
      "groupBy": "product",
      "measures": [
        {
          "op": "sum",
          "field": "revenue",
          "as": "revenue"
        }
      ]
    },
    {
      "type": "sort",
      "field": "revenue",
      "order": "desc"
    }
  ]
}
