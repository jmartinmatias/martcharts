{
  "id": "cc-revenue-bridge",
  "title": "From last year's revenue to this year's",
  "subtitle": "January to October, 2025 against 2026: what added and what took away",
  "description": "The revenue bridge from 2025 to 2026.",
  "locale": "en-US",
  "source": {
    "name": "Commercial data mart (fictional)"
  },
  "data": {
    "type": "url",
    "url": "/data/bridge-by-client.json"
  },
  "fields": {
    "step": {
      "label": "Step"
    },
    "amount": {
      "label": "Revenue",
      "format": {
        "type": "currency",
        "currency": "EUR",
        "compact": true
      }
    }
  },
  "view": {
    "type": "waterfall",
    "label": "step",
    "value": "amount",
    "totals": [
      "Revenue 2025, January to October"
    ],
    "endLabel": "Revenue 2026, January to October",
    "fit": true
  },
  "transform": [
    {
      "type": "aggregate",
      "groupBy": "step",
      "measures": [
        {
          "op": "sum",
          "field": "amount",
          "as": "amount"
        }
      ]
    }
  ]
}
