{
  "id": "cc-rm-capacity",
  "title": "Clients per relationship manager",
  "subtitle": "Against each book's capacity",
  "description": "How full each relationship manager's book is.",
  "locale": "en-US",
  "source": {
    "name": "Commercial data mart (fictional)"
  },
  "data": {
    "type": "url",
    "url": "/data/clients.json"
  },
  "fields": {
    "rm": {
      "label": "Relationship manager"
    },
    "clients": {
      "label": "Clients"
    },
    "capacity": {
      "label": "Capacity"
    }
  },
  "view": {
    "type": "bullet",
    "label": "rm",
    "value": "clients",
    "target": "capacity"
  },
  "transform": [
    {
      "type": "aggregate",
      "groupBy": "rm",
      "measures": [
        {
          "op": "count",
          "as": "clients"
        },
        {
          "op": "max",
          "field": "rmCapacity",
          "as": "capacity"
        }
      ]
    }
  ],
  "i18n": {
    "fr": {
      "title": "Clients par chargé de clientèle",
      "subtitle": "Face à la capacité de chaque portefeuille",
      "description": "Le taux de remplissage du portefeuille de chaque chargé.",
      "source": {
        "name": "Datamart commercial (fictif)"
      },
      "fields": {
        "rm": {
          "label": "Chargé de clientèle"
        },
        "capacity": {
          "label": "Capacité"
        }
      }
    },
    "de": {
      "title": "Kunden je Kundenberater",
      "subtitle": "Gegen die Kapazität jedes Bestands",
      "description": "Wie voll der Bestand jedes Kundenberaters ist.",
      "source": {
        "name": "Vertriebs-Data-Mart (fiktiv)"
      },
      "fields": {
        "rm": {
          "label": "Kundenberater"
        },
        "clients": {
          "label": "Kunden"
        },
        "capacity": {
          "label": "Kapazität"
        }
      }
    }
  }
}
