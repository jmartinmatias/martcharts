{
  "id": "cc-rm-meetings",
  "title": "Client meetings this year",
  "subtitle": "Held so far against the yearly target",
  "description": "Meetings held per relationship manager against the target.",
  "locale": "en-US",
  "source": {
    "name": "Commercial data mart (fictional)"
  },
  "data": {
    "type": "url",
    "url": "/data/clients.json"
  },
  "transform": [
    {
      "type": "aggregate",
      "groupBy": "rm",
      "measures": [
        {
          "op": "sum",
          "field": "meetingsYtd",
          "as": "meetingsYtd"
        },
        {
          "op": "sum",
          "field": "meetingTarget",
          "as": "target"
        }
      ]
    },
    {
      "type": "sort",
      "field": "meetingsYtd",
      "order": "desc"
    }
  ],
  "fields": {
    "rm": {
      "label": "Relationship manager"
    },
    "meetingsYtd": {
      "label": "Meetings held"
    },
    "target": {
      "label": "Target"
    }
  },
  "view": {
    "type": "hbar",
    "label": "rm",
    "value": [
      "meetingsYtd",
      "target"
    ]
  },
  "i18n": {
    "fr": {
      "title": "Rendez-vous clients de l'année",
      "subtitle": "Tenus à ce jour face à l'objectif annuel",
      "description": "Rendez-vous tenus par chargé de clientèle face à l'objectif.",
      "source": {
        "name": "Datamart commercial (fictif)"
      },
      "fields": {
        "rm": {
          "label": "Chargé de clientèle"
        },
        "meetingsYtd": {
          "label": "Rendez-vous tenus"
        },
        "target": {
          "label": "Objectif"
        }
      }
    },
    "de": {
      "title": "Kundentermine dieses Jahres",
      "subtitle": "Bisher gehalten gegen das Jahresziel",
      "description": "Gehaltene Termine je Kundenberater gegen das Ziel.",
      "source": {
        "name": "Vertriebs-Data-Mart (fiktiv)"
      },
      "fields": {
        "rm": {
          "label": "Kundenberater"
        },
        "meetingsYtd": {
          "label": "Gehaltene Termine"
        },
        "target": {
          "label": "Ziel"
        }
      }
    }
  }
}
