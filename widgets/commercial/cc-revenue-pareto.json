{
  "id": "cc-revenue-pareto",
  "title": "Revenue by client",
  "subtitle": "Largest first, with their running share",
  "description": "Clients by revenue, with the running share of the total.",
  "locale": "en-US",
  "source": {
    "name": "Commercial data mart (fictional)"
  },
  "data": {
    "type": "url",
    "url": "/data/clients.json"
  },
  "transform": [
    {
      "type": "sort",
      "field": "revenue",
      "order": "desc"
    },
    {
      "type": "limit",
      "count": 20
    }
  ],
  "fields": {
    "name": {
      "label": "Client"
    },
    "revenue": {
      "label": "Revenue",
      "format": {
        "type": "currency",
        "currency": "EUR",
        "compact": true
      }
    }
  },
  "view": {
    "type": "pareto",
    "label": "name",
    "value": "revenue"
  },
  "i18n": {
    "fr": {
      "title": "CA par client",
      "subtitle": "Le plus grand d'abord, avec la part cumulée",
      "description": "Clients par CA, avec la part cumulée du total.",
      "source": {
        "name": "Datamart commercial (fictif)"
      },
      "fields": {
        "revenue": {
          "label": "Chiffre d'affaires"
        }
      }
    },
    "de": {
      "title": "Umsatz je Kunde",
      "subtitle": "Größte zuerst, mit kumuliertem Anteil",
      "description": "Kunden nach Umsatz, mit dem kumulierten Anteil am Gesamt.",
      "source": {
        "name": "Vertriebs-Data-Mart (fiktiv)"
      },
      "fields": {
        "name": {
          "label": "Kunde"
        },
        "revenue": {
          "label": "Umsatz"
        }
      }
    }
  }
