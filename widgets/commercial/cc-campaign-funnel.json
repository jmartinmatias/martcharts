{
  "id": "cc-campaign-funnel",
  "title": "Campaigns, step by step",
  "subtitle": "This year, from clients targeted to clients converted",
  "description": "How many clients this year's campaigns targeted, reached, heard back from and converted, all campaigns together.",
  "locale": "en-US",
  "source": {
    "name": "Commercial data mart (fictional)"
  },
  "data": {
    "type": "url",
    "url": "/data/campaign-stages.json"
  },
  "fields": {
    "stage": {
      "label": "Step"
    },
    "clients": {
      "label": "Clients"
    }
  },
  "view": {
    "type": "funnel",
    "label": "stage",
    "value": "clients"
  },
  "transform": [
    {
      "type": "aggregate",
      "groupBy": "stage",
      "measures": [
        {
          "op": "sum",
          "field": "clients",
          "as": "clients"
        }
      ]
    }
  ]
}
