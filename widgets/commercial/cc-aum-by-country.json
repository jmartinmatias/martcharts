{
  "id": "cc-aum-by-country",
  "title": "Where the assets are",
  "subtitle": "AuM by country, 2026 year to date",
  "description": "Client assets summed by country, shaded on a map of Europe.",
  "locale": "en-US",
  "source": {
    "name": "Commercial data mart (fictional)"
  },
  "data": {
    "type": "url",
    "url": "/data/clients.json"
  },
  "transform": [
    {
      "type": "aggregate",
      "groupBy": "country",
      "measures": [
        {
          "op": "sum",
          "field": "aum",
          "as": "aum"
        }
      ]
    }
  ],
  "fields": {
    "country": {
      "label": "Country"
    },
    "aum": {
      "label": "AuM",
      "format": {
        "type": "currency",
        "currency": "EUR",
        "compact": true
      }
    }
  },
  "view": {
    "type": "choropleth",
    "geo": "europe",
    "id": "country",
    "value": "aum"
  },
  "i18n": {
    "fr": {
      "title": "Où sont les actifs",
      "subtitle": "Actifs par pays, 2026 depuis janvier",
      "description": "Actifs clients sommés par pays, sur une carte de l'Europe.",
      "source": {
        "name": "Datamart commercial (fictif)"
      },
      "fields": {
        "country": {
          "label": "Pays"
        },
        "aum": {
          "label": "Actifs gérés"
        }
      }
    },
    "de": {
      "title": "Wo das Vermögen liegt",
      "subtitle": "AuM nach Land, 2026 seit Jahresbeginn",
      "description": "Kundenvermögen je Land, auf einer Europakarte schattiert.",
      "source": {
        "name": "Vertriebs-Data-Mart (fiktiv)"
      },
      "fields": {
        "country": {
          "label": "Land"
        }
      }
    }
  }
}
