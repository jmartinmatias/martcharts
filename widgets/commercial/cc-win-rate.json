{
  "id": "cc-win-rate",
  "title": "Win rate, by banker",
  "subtitle": "Deals won out of deals decided this year, against the 35% the plan expects",
  "description": "Each relationship manager's deals won as a share of the deals won or lost this year, against the plan's win rate.",
  "locale": "en-US",
  "source": {
    "name": "Commercial data mart (fictional)"
  },
  "data": {
    "type": "url",
    "url": "/data/pipeline-by-book.json"
  },
  "transform": [
    {
      "type": "aggregate",
      "groupBy": "rm",
      "measures": [
        {
          "op": "sum",
          "field": "won",
          "as": "won"
        },
        {
          "op": "sum",
          "field": "decided",
          "as": "decided"
        },
        {
          "op": "sum",
          "field": "wonTarget",
          "as": "wonTarget"
        }
      ]
    },
    {
      "type": "calc",
      "as": "winRate",
      "op": "divide",
      "left": "won",
      "right": "decided"
    },
    {
      "type": "calc",
      "as": "winRateTarget",
      "op": "divide",
      "left": "wonTarget",
      "right": "decided"
    },
    {
      "type": "sort",
      "field": "winRate",
      "order": "desc"
    }
  ],
  "fields": {
    "rm": {
      "label": "Relationship manager"
    },
    "winRate": {
      "label": "Win rate",
      "format": {
        "type": "percent"
      }
    },
    "winRateTarget": {
      "label": "Target",
      "format": {
        "type": "percent"
      }
    }
  },
  "view": {
    "type": "bullet",
    "label": "rm",
    "value": "winRate",
    "target": "winRateTarget"
  },
  "i18n": {
    "fr": {
      "title": "Taux de réussite, par chargé",
      "subtitle": "Affaires gagnées sur les affaires tranchées cette année, face aux 35 % du plan",
      "description": "Les affaires gagnées de chaque chargé en part des affaires gagnées ou perdues cette année, face au taux du plan.",
      "source": {
        "name": "Datamart commercial (fictif)"
      },
      "fields": {
        "rm": {
          "label": "Chargé de clientèle"
        },
        "winRate": {
          "label": "Taux de réussite"
        },
        "winRateTarget": {
          "label": "Objectif"
        }
      }
    },
    "de": {
      "title": "Abschlussquote, je Berater",
      "subtitle": "Gewonnene von den entschiedenen Deals dieses Jahres, gegen die 35 % des Plans",
      "description": "Gewonnene Deals jedes Kundenberaters als Anteil der gewonnenen oder verlorenen Deals dieses Jahres, gegen die Planquote.",
      "source": {
        "name": "Vertriebs-Data-Mart (fiktiv)"
      },
      "fields": {
        "rm": {
          "label": "Kundenberater"
        },
        "winRate": {
          "label": "Abschlussquote"
        },
        "winRateTarget": {
          "label": "Ziel"
        }
      }
    }
  }
}
