{
  "id": "cc-penetration-gap",
  "title": "Penetration against target",
  "subtitle": "Each product now and at year end, set for the whole book",
  "description": "Each product's penetration today and its year-end target; the arrow points the way it has to move.",
  "locale": "en-US",
  "source": {
    "name": "Commercial data mart (fictional)"
  },
  "data": {
    "type": "url",
    "url": "/data/holdings.json"
  },
  "transform": [
    {
      "type": "aggregate",
      "groupBy": "product",
      "measures": [
        {
          "op": "sum",
          "field": "held",
          "as": "holders"
        },
        {
          "op": "count",
          "as": "clients"
        },
        {
          "op": "max",
          "field": "penetrationTarget",
          "as": "penetrationTarget"
        }
      ]
    },
    {
      "type": "calc",
      "as": "penetration",
      "op": "divide",
      "left": "holders",
      "right": "clients"
    },
    {
      "type": "sort",
      "field": "penetration",
      "order": "desc"
    }
  ],
  "fields": {
    "product": {
      "label": "Product"
    },
    "penetration": {
      "label": "Today",
      "format": {
        "type": "percent"
      }
    },
    "penetrationTarget": {
      "label": "Target",
      "format": {
        "type": "percent"
      }
    }
  },
  "view": {
    "type": "dumbbell",
    "label": "product",
    "from": "penetration",
    "to": "penetrationTarget",
    "mark": "arrow"
  }
}
