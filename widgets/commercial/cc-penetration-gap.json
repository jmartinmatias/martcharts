{
  "id": "cc-penetration-gap",
  "title": "Penetration against target",
  "subtitle": "Each product now and at year end, set for the whole book",
  "description": "Each product's penetration today and its year-end target; the arrow points the way it has to move.",
  "locale": "en-US",
  "source": {
    "name": "Commercial data mart (fictional)"
  },
  "data": {
    "type": "url",
    "url": "/data/holdings.json"
  },
  "transform": [
    {
      "type": "aggregate",
      "groupBy": "product",
      "measures": [
        {
          "op": "sum",
          "field": "held",
          "as": "holders"
        },
        {
          "op": "count",
          "as": "clients"
        },
        {
          "op": "max",
          "field": "penetrationTarget",
          "as": "penetrationTarget"
        }
      ]
    },
    {
      "type": "calc",
      "as": "penetration",
      "op": "divide",
      "left": "holders",
      "right": "clients"
    },
    {
      "type": "sort",
      "field": "penetration",
      "order": "desc"
    }
  ],
  "fields": {
    "product": {
      "label": "Product"
    },
    "penetration": {
      "label": "Today",
      "format": {
        "type": "percent"
      }
    },
    "penetrationTarget": {
      "label": "Target",
      "format": {
        "type": "percent"
      }
    }
  },
  "view": {
    "type": "dumbbell",
    "label": "product",
    "from": "penetration",
    "to": "penetrationTarget",
    "mark": "arrow"
  },
  "i18n": {
    "fr": {
      "title": "Pénétration face à l'objectif",
      "subtitle": "Chaque produit aujourd'hui et en fin d'année, sur tout le portefeuille",
      "description": "La pénétration de chaque produit aujourd'hui et son objectif de fin d'année ; la flèche montre le sens à suivre.",
      "source": {
        "name": "Datamart commercial (fictif)"
      },
      "fields": {
        "product": {
          "label": "Produit"
        },
        "penetration": {
          "label": "Aujourd'hui"
        },
        "penetrationTarget": {
          "label": "Objectif"
        }
      }
    },
    "de": {
      "title": "Durchdringung gegen Ziel",
      "subtitle": "Jedes Produkt heute und zum Jahresende, für den ganzen Bestand",
      "description": "Durchdringung jedes Produkts heute und ihr Jahresendziel; der Pfeil zeigt die nötige Richtung.",
      "source": {
        "name": "Vertriebs-Data-Mart (fiktiv)"
      },
      "fields": {
        "product": {
          "label": "Produkt"
        },
        "penetration": {
          "label": "Heute"
        },
        "penetrationTarget": {
          "label": "Ziel"
        }
      }
    }
  }
}
