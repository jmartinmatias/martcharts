{
  "id": "cc-product-scorecard",
  "title": "Product margin and revenue per holder",
  "subtitle": "What each line earns, and what a client holding it brings",
  "description": "Each product's margin and its revenue per client holding it, 2026 year to date.",
  "locale": "en-US",
  "source": {
    "name": "Commercial data mart (fictional)"
  },
  "data": {
    "type": "url",
    "url": "/data/holdings.json"
  },
  "transform": [
    {
      "type": "aggregate",
      "groupBy": "product",
      "measures": [
        {
          "op": "sum",
          "field": "held",
          "as": "holders"
        },
        {
          "op": "sum",
          "field": "revenue",
          "as": "revenue"
        },
        {
          "op": "sum",
          "field": "marginAmount",
          "as": "marginAmount"
        }
      ]
    },
    {
      "type": "calc",
      "as": "margin",
      "op": "divide",
      "left": "marginAmount",
      "right": "revenue"
    },
    {
      "type": "calc",
      "as": "perHolder",
      "op": "divide",
      "left": "revenue",
      "right": "holders"
    },
    {
      "type": "sort",
      "field": "margin",
      "order": "desc"
    }
  ],
  "fields": {
    "product": {
      "label": "Product"
    },
    "margin": {
      "label": "Margin",
      "format": {
        "type": "percent"
      }
    },
    "perHolder": {
      "label": "Revenue per holder",
      "format": {
        "type": "currency",
        "currency": "EUR",
        "compact": true
      }
    }
  },
  "view": {
    "type": "hbar",
    "label": "product",
    "value": [
      "margin",
      "perHolder"
    ],
    "split": true
  }
}
