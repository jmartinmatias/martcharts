{
  "id": "cc-campaign-return",
  "title": "Revenue per euro spent",
  "subtitle": "By campaign",
  "description": "Each campaign's revenue divided by its cost.",
  "locale": "en-US",
  "source": {
    "name": "Commercial data mart (fictional)"
  },
  "data": {
    "type": "url",
    "url": "/data/campaign-reach.json"
  },
  "transform": [
    {
      "type": "aggregate",
      "groupBy": "campaign",
      "measures": [
        {
          "op": "sum",
          "field": "revenue",
          "as": "revenue"
        },
        {
          "op": "sum",
          "field": "cost",
          "as": "cost"
        }
      ]
    },
    {
      "type": "calc",
      "as": "return",
      "op": "divide",
      "left": "revenue",
      "right": "cost"
    },
    {
      "type": "sort",
      "field": "return",
      "order": "desc"
    }
  ],
  "fields": {
    "campaign": {
      "label": "Campaign"
    },
    "return": {
      "label": "Revenue per euro",
      "format": {
        "type": "number",
        "decimals": 1
      }
    }
  },
  "view": {
    "type": "hbar",
    "label": "campaign",
    "value": "return"
  }
}
