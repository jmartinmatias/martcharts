{
  "id": "cc-campaign-return",
  "title": "Revenue per euro spent",
  "subtitle": "By campaign",
  "description": "Each campaign's revenue divided by its cost.",
  "locale": "en-US",
  "source": {
    "name": "Commercial data mart (fictional)"
  },
  "data": {
    "type": "url",
    "url": "/data/campaign-reach.json"
  },
  "transform": [
    {
      "type": "aggregate",
      "groupBy": "campaign",
      "measures": [
        {
          "op": "sum",
          "field": "revenue",
          "as": "revenue"
        },
        {
          "op": "sum",
          "field": "cost",
          "as": "cost"
        }
      ]
    },
    {
      "type": "calc",
      "as": "return",
      "op": "divide",
      "left": "revenue",
      "right": "cost"
    },
    {
      "type": "sort",
      "field": "return",
      "order": "desc"
    }
  ],
  "fields": {
    "campaign": {
      "label": "Campaign"
    },
    "return": {
      "label": "Revenue per euro",
      "format": {
        "type": "number",
        "decimals": 1
      }
    }
  },
  "view": {
    "type": "hbar",
    "label": "campaign",
    "value": "return"
  },
  "i18n": {
    "fr": {
      "title": "CA par euro dépensé",
      "subtitle": "Par campagne",
      "description": "Le CA de chaque campagne divisé par son coût.",
      "source": {
        "name": "Datamart commercial (fictif)"
      },
      "fields": {
        "campaign": {
          "label": "Campagne"
        },
        "return": {
          "label": "CA par euro"
        }
      }
    },
    "de": {
      "title": "Umsatz je ausgegebenem Euro",
      "subtitle": "Nach Kampagne",
      "description": "Umsatz jeder Kampagne geteilt durch ihre Kosten.",
      "source": {
        "name": "Vertriebs-Data-Mart (fiktiv)"
      },
      "fields": {
        "campaign": {
          "label": "Kampagne"
        },
        "return": {
          "label": "Umsatz je Euro"
        }
      }
    }
  }
}
