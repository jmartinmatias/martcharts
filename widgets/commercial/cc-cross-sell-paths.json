{
  "id": "cc-cross-sell-paths",
  "title": "From products held to opportunities",
  "subtitle": "Client count, by what they hold and what is open",
  "description": "Which held products lead to which opportunities.",
  "locale": "en-US",
  "source": {
    "name": "Commercial data mart (fictional)"
  },
  "data": {
    "type": "url",
    "url": "/data/cross-sell-by-client.json"
  },
  "fields": {
    "from": {
      "label": "Holds"
    },
    "to": {
      "label": "Could buy"
    },
    "clients": {
      "label": "Clients"
    }
  },
  "view": {
    "type": "sankey",
    "source": "from",
    "target": "to",
    "value": "clients"
  },
  "transform": [
    {
      "type": "aggregate",
      "groupBy": [
        "from",
        "to"
      ],
      "measures": [
        {
          "op": "sum",
          "field": "clients",
          "as": "clients"
        }
      ]
    },
    {
      "type": "sort",
      "field": "clients",
      "order": "desc"
    },
    {
      "type": "limit",
      "count": 14
    }
  ],
  "i18n": {
    "fr": {
      "title": "Des produits détenus aux opportunités",
      "subtitle": "Nombre de clients, selon ce qu'ils détiennent et ce qui est ouvert",
      "description": "Quels produits détenus mènent à quelles opportunités.",
      "source": {
        "name": "Datamart commercial (fictif)"
      },
      "fields": {
        "from": {
          "label": "Détient"
        },
        "to": {
          "label": "Pourrait acheter"
        }
      }
    },
    "de": {
      "title": "Von gehaltenen Produkten zu Chancen",
      "subtitle": "Kundenzahl nach Gehaltenem und Offenem",
      "description": "Welche gehaltenen Produkte zu welchen Chancen führen.",
      "source": {
        "name": "Vertriebs-Data-Mart (fiktiv)"
      },
      "fields": {
        "from": {
          "label": "Hält"
        },
        "to": {
          "label": "Könnte kaufen"
        },
        "clients": {
          "label": "Kunden"
        }
      }
    }
  }
}
