{
  "id": "cc-cross-sell-paths",
  "title": "From what clients hold to what they could buy",
  "subtitle": "Clients by product held and open opportunity",
  "description": "Which held products lead to which opportunities.",
  "locale": "en-US",
  "source": {
    "name": "Commercial data mart (fictional)"
  },
  "data": {
    "type": "url",
    "url": "/data/cross-sell-by-client.json"
  },
  "fields": {
    "from": {
      "label": "Holds"
    },
    "to": {
      "label": "Could buy"
    },
    "clients": {
      "label": "Clients"
    }
  },
  "view": {
    "type": "sankey",
    "source": "from",
    "target": "to",
    "value": "clients"
  },
  "transform": [
    {
      "type": "aggregate",
      "groupBy": [
        "from",
        "to"
      ],
      "measures": [
        {
          "op": "sum",
          "field": "clients",
          "as": "clients"
        }
      ]
    },
    {
      "type": "sort",
      "field": "clients",
      "order": "desc"
    },
    {
      "type": "limit",
      "count": 14
    }
  ]
}
