{
  "id": "cc-headline-kpis",
  "title": "The book at a glance",
  "subtitle": "{last:month}, against the month before",
  "description": "Assets, revenue so far this year, net new money, open opportunities and cross-sell potential, month by month, summed from each client's rows so the filters reach them. Anomalies have their own watch below.",
  "locale": "en-US",
  "source": {
    "name": "Commercial data mart (fictional)"
  },
  "data": {
    "type": "url",
    "url": "/data/client-activity.json"
  },
  "fields": {
    "month": {
      "label": "Month",
      "format": {
        "type": "date",
        "style": "month"
      }
    },
    "aum": {
      "label": "AuM",
      "format": {
        "type": "currency",
        "currency": "EUR",
        "compact": true
      }
    },
    "revenueYtd": {
      "label": "Revenue YTD",
      "format": {
        "type": "currency",
        "currency": "EUR",
        "compact": true
      }
    },
    "netNewMoney": {
      "label": "Net new money",
      "format": {
        "type": "currency",
        "currency": "EUR",
        "compact": true
      }
    },
    "openOpportunities": {
      "label": "Open opportunities"
    },
    "potential": {
      "label": "Potential",
      "format": {
        "type": "currency",
        "currency": "EUR",
        "compact": true
      }
    }
  },
  "view": {
    "type": "kpis",
    "series": true,
    "items": [
      {
        "value": "aum",
        "label": "Assets under management",
        "compare": "previous"
      },
      {
        "value": "revenueYtd",
        "label": "Revenue, year to date",
        "compare": "previous"
      },
      {
        "value": "netNewMoney",
        "label": "Net new money",
        "compare": "previous"
      },
      {
        "value": "openOpportunities",
        "label": "Clients with an open opportunity",
        "compare": "previous"
      },
      {
        "value": "potential",
        "label": "Cross-sell potential",
        "compare": "previous"
      }
    ]
  },
  "transform": [
    {
      "type": "aggregate",
      "groupBy": "month",
      "measures": [
        {
          "op": "sum",
          "field": "aum",
          "as": "aum"
        },
        {
          "op": "sum",
          "field": "revenueYtd",
          "as": "revenueYtd"
        },
        {
          "op": "sum",
          "field": "netNewMoney",
          "as": "netNewMoney"
        },
        {
          "op": "sum",
          "field": "openOpportunity",
          "as": "openOpportunities"
        },
        {
          "op": "sum",
          "field": "potential",
          "as": "potential"
        }
      ]
    },
    {
      "type": "sort",
      "field": "month"
    }
  ]
}
