{
  "name": "martcharts",
  "version": "0.1.0",
  "description": "One universal widget block. Describe the data, the reshaping, the view and the style; fork it into any chart, table, list or KPI. Ships with an MCP server so agents can read and edit every widget.",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": "./src/index.ts",
    "./core": "./src/core/index.ts",
    "./kit": "./src/kit.ts",
    "./color": "./src/color.ts",
    "./geo": "./src/geo.ts",
    "./taller": "./src/taller.ts",
    "./mcp": "./src/mcp/server.ts",
    "./standalone": {
      "types": "./dist/types/standalone.d.ts",
      "default": "./dist/martcharts.js"
    },
    "./lite": {
      "types": "./dist/types/lite.d.ts",
      "default": "./dist/martcharts-lite.js"
    },
    "./dist/*": "./dist/*"
  },
  "unpkg": "dist/martcharts.iife.js",
  "jsdelivr": "dist/martcharts.iife.js",
  "files": [
    "src",
    "dist",
    "widgets",
    "dashboards",
    "catalog",
    "docs",
    "!src/**/*.test.ts"
  ],
  "bin": {
    "fft-mcp": "src/mcp/main.ts"
  },
  "scripts": {
    "dev": "vite",
    "build:demo": "vite build",
    "build:site": "vite build && npm run build:lib && node scripts/site-pages.ts",
    "build:lib": "vite build -c vite.lib.config.ts && vite build -c vite.lite.config.ts && vite build -c vite.reading.config.ts && node scripts/lib-types.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "mcp": "node src/mcp/main.ts",
    "mcp:inspect": "npx @modelcontextprotocol/inspector node src/mcp/main.ts",
    "smoke": "node scripts/smoke.ts",
    "mcp:config": "node src/mcp/main.ts --print-config",
    "docs": "node scripts/docs.ts",
    "catalog": "node scripts/catalog.ts && node scripts/guide.ts",
    "prepare": "npm run build:lib"
  },
  "engines": {
    "node": ">=23.6"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.3.1",
    "@types/node": "^26.6.5",
    "axe-core": "^4.14.0",
    "jsdom": "^30.1.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
