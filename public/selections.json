{
  "about": "Chart variations picked from the variation engine (the Taller) because they are new and meaningful. Plain words only. Engine run: 55 widgets, seeds 1 to 5, every color and marks setting, 753 unique variants, reviewed by hand. Kept only picks scoring at least 4 out of 10 for how new they are.",
  "selections": [
    {
      "source": "revenue-by-region",
      "title": "Revenue and cost, side by side: the gap is the profit",
      "change": "The grouped bars become dumbbells: one dot for revenue and one for cost in each region, joined by a line.",
      "why": "The length of each line is that region's profit, so profits compare at a glance: East keeps the most (€91K), South and West the least (about €56K each).",
      "novelty": 0.55,
      "meaning": 0.63,
      "spec": {
        "title": "Revenue by region",
        "subtitle": "Q3 2026, all products",
        "description": "Revenue and cost per sales region, largest first, with the leading region highlighted.",
        "note": "Source: /data/sales.json",
        "locale": "en-US",
        "data": {
          "type": "url",
          "url": "/data/sales.json",
          "path": "data.items"
        },
        "transform": [
          {
            "type": "aggregate",
            "groupBy": "region",
            "measures": [
              {
                "op": "sum",
                "field": "revenue"
              },
              {
                "op": "sum",
                "field": "cost"
              }
            ]
          },
          {
            "type": "sort",
            "field": "revenue",
            "order": "desc"
          }
        ],
        "fields": {
          "revenue": {
            "label": "Revenue",
            "format": {
              "type": "currency",
              "currency": "EUR",
              "decimals": 0
            }
          },
          "cost": {
            "label": "Cost",
            "format": {
              "type": "currency",
              "currency": "EUR",
              "decimals": 0
            }
          }
        },
        "view": {
          "type": "dumbbell",
          "label": "region",
          "from": "revenue",
          "to": "cost"
        },
        "style": {
          "height": 300
        }
      }
    },
    {
      "source": "plan-moves",
      "title": "Where customers go when they change plan",
      "change": "The circle of ribbons becomes columns: each column is the plan customers left, as wide as the number who left it, split by the plan they moved to.",
      "why": "Starter loses the most customers (160), and three in four of them move up to Growth. Almost nobody leaves Enterprise.",
      "novelty": 0.65,
      "meaning": 0.51,
      "spec": {
        "title": "Plan changes",
        "subtitle": "Q3 2026, customers moving between plans",
        "description": "Every upgrade and downgrade between plans this quarter. Starter to Growth is the biggest move; downgrades are the thin ribbons running back.",
        "note": "Source: billing, {sum:customers} moves",
        "locale": "en-US",
        "data": {
          "type": "inline",
          "rows": [
            {
              "from": "Starter",
              "to": "Growth",
              "customers": 120
            },
            {
              "from": "Starter",
              "to": "Pro",
              "customers": 40
            },
            {
              "from": "Growth",
              "to": "Pro",
              "customers": 85
            },
            {
              "from": "Growth",
              "to": "Starter",
              "customers": 30
            },
            {
              "from": "Growth",
              "to": "Enterprise",
              "customers": 10
            },
            {
              "from": "Pro",
              "to": "Enterprise",
              "customers": 25
            },
            {
              "from": "Pro",
              "to": "Growth",
              "customers": 18
            },
            {
              "from": "Enterprise",
              "to": "Pro",
              "customers": 6
            }
          ]
        },
        "fields": {
          "customers": {
            "label": "Customers",
            "format": {
              "type": "number"
            }
          },
          "from": {
            "label": "Plan they left"
          },
          "to": {
            "label": "Plan they joined"
          }
        },
        "view": {
          "type": "marimekko",
          "x": "from",
          "series": "to",
          "value": "customers"
        },
        "style": {
          "height": 300
        }
      }
    },
    {
      "source": "order-calendar",
      "title": "How many orders a day: there are two kinds of day",
      "change": "The calendar becomes a histogram: days are grouped by how many orders they had, and each bar counts the days in one range.",
      "why": "The bars form two humps: weekend days get 34 to 96 orders, weekdays 112 to 225. Planning for an average day would be wrong both ways.",
      "novelty": 0.49,
      "meaning": 0.57,
      "spec": {
        "title": "Daily orders",
        "subtitle": "{first:day} to {last:day}",
        "description": "Orders per day, to spot weekly rhythm, quiet weekends and growth.",
        "note": "Source: /data/daily-orders.json",
        "locale": "en-US",
        "data": {
          "type": "url",
          "url": "/data/daily-orders.json"
        },
        "fields": {
          "orders": {
            "label": "Orders",
            "format": "number"
          },
          "day": {
            "label": "Day",
            "format": {
              "type": "date",
              "style": "medium"
            }
          }
        },
        "view": {
          "type": "histogram",
          "value": "orders"
        },
        "style": {
          "height": 300
        }
      }
    },
    {
      "source": "product-compare",
      "title": "Us against the market, one attribute at a time",
      "change": "The radar's two shapes become dumbbells: our score and the market's, joined by a line for each attribute.",
      "why": "We lead on five of six attributes, most on Support (8.2 against 6.4). Price is the one place we trail (6.1 against 7.4).",
      "novelty": 0.45,
      "meaning": 0.63,
      "spec": {
        "title": "How we compare",
        "subtitle": "Customer ratings out of 10, against the market average",
        "description": "Average customer rating per attribute for our product and for the market. We lead on reliability and ease of use and trail only on price.",
        "note": "Source: customer survey and analyst panel",
        "locale": "en-US",
        "data": {
          "type": "inline",
          "rows": [
            {
              "attribute": "Speed",
              "us": 8.6,
              "market": 6.9
            },
            {
              "attribute": "Reliability",
              "us": 9.1,
              "market": 7.8
            },
            {
              "attribute": "Support",
              "us": 8.2,
              "market": 6.4
            },
            {
              "attribute": "Price",
              "us": 6.1,
              "market": 7.4
            },
            {
              "attribute": "Integrations",
              "us": 7.4,
              "market": 6.8
            },
            {
              "attribute": "Ease of use",
              "us": 8.8,
              "market": 7.1
            }
          ]
        },
        "fields": {
          "us": {
            "label": "Our product",
            "format": {
              "type": "number",
              "decimals": 1
            }
          },
          "market": {
            "label": "Market average",
            "format": {
              "type": "number",
              "decimals": 1
            }
          }
        },
        "view": {
          "type": "dumbbell",
          "label": "attribute",
          "from": "us",
          "to": "market"
        },
        "style": {
          "height": 300
        }
      }
    },
    {
      "source": "region-targets",
      "title": "How far each region is from its target",
      "change": "The progress meters become bars that start at the target and go right when a region beats it and left when it falls short.",
      "why": "North and Central beat their targets; East, West and South fall short, South by the most (€26K).",
      "novelty": 0.45,
      "meaning": 0.68,
      "spec": {
        "title": "Target attainment",
        "subtitle": "Q3 2026 revenue against target",
        "description": "How close each region is to its quarterly revenue target.",
        "note": "Source: /data/sales.json",
        "locale": "en-US",
        "data": {
          "type": "url",
          "url": "/data/sales.json",
          "path": "data.items"
        },
        "transform": [
          {
            "type": "aggregate",
            "groupBy": "region",
            "measures": [
              {
                "op": "sum",
                "field": "revenue"
              },
              {
                "op": "sum",
                "field": "target"
              }
            ]
          },
          {
            "type": "sort",
            "field": "revenue",
            "order": "desc"
          }
        ],
        "fields": {
          "revenue": {
            "format": {
              "type": "currency",
              "currency": "EUR",
              "compact": true
            }
          },
          "target": {
            "format": {
              "type": "currency",
              "currency": "EUR",
              "compact": true
            }
          }
        },
        "view": {
          "type": "variance",
          "label": "region",
          "value": "revenue",
          "target": "target"
        },
        "style": {
          "height": 300
        }
      }
    },
    {
      "source": "revenue-vs-target",
      "title": "Revenue against target, month by month: a check for every month that made it",
      "change": "The bars with a target line become one row per month: a bar for revenue, a tick for the target, and a check beside each month that reached it.",
      "why": "It reads like a scorecard: 7 of 12 months made their target, and every miss came before June (Oct, Nov, Jan, Feb and May). From June on, every month passed, September by the most (€84K).",
      "novelty": 0.49,
      "meaning": 0.67,
      "spec": {
        "title": "Revenue against target",
        "subtitle": "{first:month} to {last:month}",
        "description": "Monthly revenue as bars with the monthly target as a line, on one axis.",
        "note": "Source: /data/monthly.json",
        "locale": "en-US",
        "data": {
          "type": "url",
          "url": "/data/monthly.json"
        },
        "fields": {
          "month": {
            "label": "Month",
            "format": {
              "type": "date",
              "style": "month"
            }
          },
          "revenue": {
            "label": "Revenue",
            "format": {
              "type": "currency",
              "currency": "EUR",
              "compact": true
            }
          },
          "target": {
            "label": "Target",
            "format": {
              "type": "currency",
              "currency": "EUR",
              "compact": true
            }
          }
        },
        "view": {
          "type": "bullet",
          "label": "month",
          "value": "revenue",
          "target": "target"
        },
        "id": "revenue-vs-target-taller-bullet",
        "style": {
          "height": 300
        }
      }
